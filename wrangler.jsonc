{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hobbigo",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "upload": {
    "format": "modules",
    "rules": [
      { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
    ]
  }
}
