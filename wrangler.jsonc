{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hobbigo",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
