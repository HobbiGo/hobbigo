    name:"Ubud Heritage Dining",
    location:"Ubud, Bali",
    price:950000,
    unit:"package",
    rating:"4.9",
    tag:"Premium",
    icon:"🍽️"
},

{
    id:14,
    type:"Boat",
    name:"Nusa Penida Private Boat",
    location:"Sanur → Nusa Penida",
    price:1800000,
    unit:"package",
    rating:"4.9",
    tag:"Private",
    icon:"🚤"
},

{
    id:15,
    type:"Boat",
    name:"Bali Sunset Cruise",
    location:"Benoa, Bali",
    price:750000,
    unit:"person",
    rating:"4.8",
    tag:"Sunset",
    icon:"⛵"
},

{
    id:16,
    type:"Ticket",
    name:"Bali Cultural Pass",
    location:"Bali",
    price:550000,
    unit:"person",
    rating:"4.7",
    tag:"Culture",
    icon:"🎟️"
},

{
    id:17,
    type:"Ticket",
    name:"Bali Adventure Pass",
    location:"Bali",
    price:1250000,
    unit:"person",
    rating:"4.8",
    tag:"Adventure",
    icon:"🎫"
}

];

let selected = [];
let currentFilter = "All";
let planningMode = "AI Plan";
let selectedPayment = "Demo Card";
let bookingId = null;
let customStops = [];


/* ============================================================
   HELPERS
============================================================ */

function rupiah(value){

    return new Intl.NumberFormat(
        "id-ID",
        {
            style:"currency",
            currency:"IDR",
            maximumFractionDigits:0
        }
    ).format(value || 0);

}

function getTravelers(){

    return Number(
        document.getElementById("travelers")?.value || 1
    );

}

function getBudget(){

    return Number(
        document.getElementById("budget")?.value || 0
    );

}

function productCost(product){

    if(product.unit === "person"){
        return product.price * getTravelers();
    }

    return product.price;

}

function getProductsTotal(){

    return selected.reduce(
        (sum,p)=>sum + productCost(p),
        0
    );

}

function getFee(){

    const subtotal = getProductsTotal();

    if(subtotal <= 0) return 0;

    return Math.max(
        50000,
        Math.round(subtotal * .035)
    );

}

function getGrandTotal(){

    return getProductsTotal() + getFee();

}

function toast(message){

    const el = document.getElementById("toast");

    el.textContent = message;
    el.classList.add("show");

    setTimeout(()=>{
        el.classList.remove("show");
    },2500);

}


/* ============================================================
   PAGE NAVIGATION
============================================================ */

function showPage(page){

    document.querySelectorAll(".page")
        .forEach(p=>p.classList.remove("active"));

    const target = document.getElementById(page);

    if(target){
        target.classList.add("active");
    }

    document.querySelectorAll(".navlinks button")
        .forEach(b=>b.classList.remove("active"));

    const nav = document.getElementById("nav-"+page);

    if(nav){
        nav.classList.add("active");
    }

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

    refreshPage(page);

}


/* ============================================================
   REFRESH PAGE
============================================================ */

function refreshPage(page){

    updateBudget();

    if(page==="marketplace"){
        renderMarketplace();
    }

    if(page==="pick"){
        renderSelections();
    }

    if(page==="route"){
        renderRoute();
    }

    if(page==="package"){
        renderSummary();
    }

    if(page==="optimize"){
        renderOptimization();
    }

    if(page==="cart"){
        renderCart();
    }

    if(page==="booking"){
        document.getElementById("bookingTotal").textContent =
            rupiah(getGrandTotal());
    }

    if(page==="mytrip"){
        renderMyTrip();
    }

}


/* ============================================================
   PLANNER
============================================================ */

function setMode(mode){

    planningMode = mode;

    document.querySelectorAll(".mode")
        .forEach(m=>m.classList.remove("active"));

    if(mode==="AI Plan"){
        document.getElementById("mode-ai").classList.add("active");
    }

    if(mode==="Manual Pick"){
        document.getElementById("mode-manual").classList.add("active");
    }

    if(mode==="AI + Manual"){
        document.getElementById("mode-hybrid").classList.add("active");
    }

}

function generatePlan(){

    const destination =
        document.getElementById("destination").value;

    const style =
        document.getElementById("style").value;

    const interest =
        document.getElementById("interest").value;

    const budget = getBudget();

    document.getElementById("aiMessage").innerHTML =
        `
        <strong>Journey configured.</strong><br><br>
        Destination: ${destination}<br>
        Style: ${style}<br>
        Interest: ${interest}<br>
        Budget: ${rupiah(budget)}<br>
        Mode: ${planningMode}
        <br><br>
        HobbiGo AI is ready to recommend products
        from the marketplace.
        `;

    if(planningMode !== "Manual Pick"){

        const recommendations = products.filter(p=>{

            if(interest==="Nature"){
                return ["Hotel","Villa","Attraction","Activity"].includes(p.type);
            }

            if(interest==="Culinary"){
                return ["Restaurant","Activity","Hotel"].includes(p.type);
            }

            if(interest==="Adventure"){
                return ["Activity","Boat","Ticket","Transport"].includes(p.type);
            }

            if(interest==="Culture"){
                return ["Attraction","Activity","Restaurant","Ticket"].includes(p.type);
            }

            return ["Hotel","Transport","Restaurant"].includes(p.type);

        }).slice(0,4);

        recommendations.forEach(p=>{

            if(!selected.some(x=>x.id===p.id)){
                selected.push(p);
            }

        });

    }

    updateBudget();

    toast("AI Journey configuration created");

    showPage("marketplace");

}


/* ============================================================
   MARKETPLACE
============================================================ */

function renderFilters(){

    const types = [
        "All",
        "Hotel",
        "Villa",
        "Flight",
        "Transport",
        "Restaurant",
        "Attraction",
        "Activity",
        "Boat",
        "Ticket"
    ];

    document.getElementById("filters").innerHTML =
        types.map(type=>`
            <button
                class="filter ${currentFilter===type ? "active":""}"
                onclick="setFilter('${type}')">
                ${type}
            </button>
        `).join("");

}

function setFilter(type){

    currentFilter = type;

    renderFilters();
    renderMarketplace();

}

function renderMarketplace(){

    renderFilters();

    const list =
        currentFilter==="All"
        ? products
        : products.filter(p=>p.type===currentFilter);

    document.getElementById("productGrid").innerHTML =
        list.map(p=>{

            const isSelected =
                selected.some(x=>x.id===p.id);

            return `

            <div class="card product">

                <div class="product-img ${p.type.toLowerCase()}">

                    <div class="badge">
                        ${p.tag}
                    </div>

                    <div style="
                        position:absolute;
                        left:18px;
                        top:48px;
                        font-size:45px;
                        color:white;
                        opacity:.9">
                        ${p.icon}
                    </div>

                </div>

                <div class="product-body">

                    <h3>${p.name}</h3>

                    <div class="product-meta">
                        ${p.location} • ★ ${p.rating}
                    </div>

                    <div class="price">
                        ${rupiah(p.price)}
                        <span style="
                            font-size:10px;
                            color:#718096;
                            font-weight:500">
                            / ${p.unit}
                        </span>
                    </div>

                    <div class="product-footer">

                        <button
                            class="btn btn-outline"
                            onclick="viewProduct(${p.id})">
                            Details
                        </button>

                        <button
                            class="btn ${isSelected ? "btn-dark":"btn-primary"}"
                            onclick="toggleProduct(${p.id})">
                            ${isSelected ? "✓ Added":"＋ Add"}
                        </button>

                    </div>

                </div>

            </div>

            `;

        }).join("");

}


/* ============================================================
   PRODUCT ACTIONS
============================================================ */

function toggleProduct(id){

    const p = products.find(x=>x.id===id);

    if(!p) return;

    const exists =
        selected.some(x=>x.id===id);

    if(exists){

        selected =
            selected.filter(x=>x.id!==id);

        toast(p.name+" removed");

    }else{

        selected.push(p);

        toast(p.name+" added to journey");

    }

    updateBudget();
    renderMarketplace();

}

function viewProduct(id){

    const p = products.find(x=>x.id===id);

    if(!p) return;

    document.getElementById("modalTitle").textContent =
        p.name;

    document.getElementById("modalBody").innerHTML =
        `
        <div style="
            background:linear-gradient(135deg,#0a1b30,#345b73);
            height:190px;
            border-radius:15px;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:75px;
            margin-bottom:20px">
            ${p.icon}
        </div>

        <h3>${p.name}</h3>

        <p style="color:#718096;margin:8px 0 15px">
            ${p.location} • ★ ${p.rating}
        </p>

        <div style="
            font-size:24px;
            font-weight:900;
            margin-bottom:15px">
            ${rupiah(p.price)}
        </div>

        <p style="
            color:#5f6b7a;
            line-height:1.7">
            Demo marketplace product for HobbiGo V78.0.
            In the production system this card can be connected
            to partner inventory, live availability, images,
            reviews, maps and real booking APIs.
        </p>

        <button
            class="btn btn-primary"
            style="width:100%;margin-top:20px"
            onclick="toggleProduct(${p.id});closeModal()">
            Add / Remove From Journey
        </button>
        `;

    document.getElementById("modal")
        .classList.add("show");

}

function closeModal(){

    document.getElementById("modal")
        .classList.remove("show");

}


/* ============================================================
   SELECTIONS
============================================================ */

function renderSelections(){

    const list =
        document.getElementById("selectionList");

    document.getElementById("pickCount").textContent =
        selected.length+" items selected";

    if(selected.length===0){

        list.innerHTML =
            `
            <div style="
                text-align:center;
                padding:50px 20px;
                color:#718096">
                <div style="font-size:45px">🧳</div>
                <h3 style="margin:10px 0">
                    Your journey is empty
                </h3>
                <p>
                    Go to Marketplace and pick your travel products.
                </p>
            </div>
            `;

    }else{

        list.innerHTML =
            selected.map((p,index)=>`

                <div class="selected-item">

                    <div class="selected-info">

                        <div class="mini-icon">
                            ${p.icon}
                        </div>

                        <div>
                            <strong>${p.name}</strong>

                            <div style="
                                color:#718096;
                                font-size:12px;
                                margin-top:4px">
                                ${p.type} • ${p.location}
                            </div>
                        </div>

                    </div>

                    <div style="text-align:right">

                        <strong>
                            ${rupiah(productCost(p))}
                        </strong>

                        <br>

                        <button
                            class="btn btn-outline"
                            style="
                                padding:5px 9px;
                                margin-top:5px;
                                font-size:11px"
                            onclick="removeSelected(${p.id})">
                            Remove
                        </button>

                    </div>

                </div>

            `).join("");

    }

    const subtotal = getProductsTotal();
    const fee = getFee();
    const total = getGrandTotal();

    document.getElementById("pickProductTotal").textContent =
        rupiah(subtotal);

    document.getElementById("pickFee").textContent =
        rupiah(fee);

    document.getElementById("pickGrandTotal").textContent =
        rupiah(total);

    document.getElementById("pickTotal").textContent =
        rupiah(total);

}

function removeSelected(id){

    selected =
        selected.filter(p=>p.id!==id);

    renderSelections();
    updateBudget();

    toast("Item removed");

}

function clearCart(){

    selected=[];

    renderSelections();
    updateBudget();

    toast("Journey selections cleared");

}


/* ============================================================
   BUDGET
============================================================ */

function updateBudget(){

    const budget = getBudget();
    const spent = getGrandTotal();
    const remaining = budget - spent;

    const percent =
        budget>0
        ? Math.min(100,(spent/budget)*100)
        : 0;

    const progress =
        document.getElementById("budgetProgress");

    if(progress){
        progress.style.width=percent+"%";
    }

    const bd =
        document.getElementById("budgetDisplay");

    if(bd){
        bd.textContent=rupiah(budget);
    }

    const bs =
        document.getElementById("budgetSpent");

    if(bs){
        bs.textContent=rupiah(spent);
    }

    const br =
        document.getElementById("budgetRemaining");

    if(br){
        br.textContent=rupiah(remaining);
    }

}


/* ============================================================
   ROUTE
============================================================ */

function renderRoute(){

    const routeList =
        document.getElementById("routeList");

    if(selected.length===0){

        routeList.innerHTML =
            `
            <div style="
                text-align:center;
                padding:45px;
                color:#718096">
                Select products first.
            </div>
            `;

        return;

    }

    const routeItems = [...selected];

    routeItems.push(
        {
            id:"custom1",
            type:"Custom",
            name:"Free Time / Personal Exploration",
            location:"Flexible",
            icon:"✨"
        }
    );

    routeList.innerHTML =
        routeItems.map((p,i)=>`

            <div class="route-item">

                <div class="route-dot">
                    ${i+1}
                </div>

                <div class="route-box">

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        gap:10px">

                        <div>
                            <strong>
                                ${p.icon} ${p.name}
                            </strong>

                            <div style="
                                color:#718096;
                                font-size:12px;
                                margin-top:5px">
                                ${p.location || "Bali"}
                            </div>
                        </div>

                        <button
                            class="btn btn-outline"
                            style="padding:6px 9px"
                            onclick="moveRoute(${i},-1)">
                            ↑
                        </button>

                    </div>

                </div>

            </div>

        `).join("");

}

function moveRoute(index,direction){

    if(index<0 || index>=selected.length) return;

    const newIndex=index+direction;

    if(newIndex<0 || newIndex>=selected.length) return;

    const temp=selected[index];

    selected[index]=selected[newIndex];
    selected[newIndex]=temp;

    renderRoute();

}

function optimizeRoute(){

    selected.sort((a,b)=>{

        const order={
            Flight:1,
            Transport:2,
            Hotel:3,
            Villa:3,
            Attraction:4,
            Activity:5,
            Restaurant:6,
            Boat:7,
            Ticket:8
        };

        return (order[a.type]||9)-(order[b.type]||9);

    });

    renderRoute();

    toast("AI route optimized");

}

function addRouteStop(){

    customStops.push({
        id:"custom-"+Date.now(),
        name:"Custom Journey Stop",
        location:"Customer selected location",
        icon:"📍"
    });

    toast("Custom stop added");

    renderRoute();

}


/* ============================================================
   PACKAGE SUMMARY
============================================================ */

function renderSummary(){

    const productsTotal=getProductsTotal();
    const fee=getFee();
    const total=getGrandTotal();
    const travelers=getTravelers();

    document.getElementById("summaryProducts").textContent =
        rupiah(productsTotal);

    document.getElementById("summaryFee").textContent =
        rupiah(fee);

    document.getElementById("summaryTotal").textContent =
        rupiah(total);

    document.getElementById("summaryTravelers").textContent =
        travelers;

    document.getElementById("summaryPerPerson").textContent =
        rupiah(travelers ? total/travelers : total);

    document.getElementById("summaryGrand").textContent =
        rupiah(total);

    const destination =
        document.getElementById("destination").value;

    document.getElementById("packageName").textContent =
        destination+" Smart Journey";

}


/* ============================================================
   OPTIMIZATION
============================================================ */

function renderOptimization(){

    const current=getGrandTotal();

    const saving =
        selected.length>2
        ? Math.round(current*.08)
        : Math.round(current*.04);

    const newTotal =
        Math.max(0,current-saving);

    document.getElementById("optCurrent").textContent =
        rupiah(current);

    document.getElementById("optSaving").textContent =
        rupiah(saving);

    document.getElementById("optNew").textContent =
        rupiah(newTotal);

    document.getElementById("optimizationMessage").innerHTML =
        `
        <strong>AI recommendation ready.</strong><br><br>

        HobbiGo detected opportunities to improve
        the current journey based on price,
        route efficiency and selected experiences.
        <br><br>

        Potential estimated saving:
        <strong>${rupiah(saving)}</strong>
        `;

}

function applyOptimization(){

    if(selected.length>3){

        const expensiveIndex =
            selected.reduce(
                (max,p,i)=>
                productCost(p)>productCost(selected[max])
                ? i
                : max,
                0
            );

        selected.splice(expensiveIndex,1);

    }

    renderOptimization();
    updateBudget();
    renderSelections();

    toast("AI optimization applied");

}


/* ============================================================
   CART
============================================================ */

function renderCart(){

    const list =
        document.getElementById("cartList");

    if(selected.length===0){

        list.innerHTML =
            `
            <div style="
                padding:60px;
                text-align:center;
                color:#718096">
                <div style="font-size:50px">🛒</div>
                <h3>Your cart is empty</h3>
            </div>
            `;

    }else{

        list.innerHTML =
            selected.map(p=>`

                <div class="cart-item">

                    <div>
                        <strong>
                            ${p.icon} ${p.name}
                        </strong>

                        <div style="
                            color:#718096;
                            font-size:12px;
                            margin-top:5px">
                            ${p.type} • ${p.location}
                        </div>
                    </div>

                    <strong>
                        ${rupiah(productCost(p))}
                    </strong>

                </div>

            `).join("");

    }

    document.getElementById("cartProducts").textContent =
        rupiah(getProductsTotal());

    document.getElementById("cartFee").textContent =
        rupiah(getFee());

    document.getElementById("cartTotal").textContent =
        rupiah(getGrandTotal());

}


/* ============================================================
   PAYMENT
============================================================ */

function selectPayment(button,method){

    document.querySelectorAll(".payment")
        .forEach(p=>p.classList.remove("active"));

    button.classList.add("active");

    selectedPayment=method;

    toast(method+" selected");

}

function confirmBooking(){

    if(selected.length===0){

        toast("Please select at least one journey item");

        showPage("marketplace");

        return;

    }

    bookingId =
        "HBG-"+Date.now().toString().slice(-8);

    document.getElementById("bookingIdDisplay").textContent =
        "Booking ID: "+bookingId;

    toast("Demo booking confirmed");

    showPage("mytrip");

}


/* ============================================================
   MY TRIP
============================================================ */

function renderMyTrip(){

    const destination =
        document.getElementById("destination").value;

    document.getElementById("myTripTitle").textContent =
        destination+" Smart Journey";

    if(bookingId){

        document.getElementById("bookingIdDisplay").textContent =
            "Booking ID: "+bookingId+
            " • "+selectedPayment+
            " • "+rupiah(getGrandTotal());

    }

    const container =
        document.getElementById("myTripItems");

    if(selected.length===0){

        container.innerHTML =
            `<p style="color:#718096">No journey items yet.</p>`;

        return;

    }

    container.innerHTML =
        selected.map((p,i)=>`

            <div style="
                display:flex;
                justify-content:space-between;
                padding:13px 0;
                border-bottom:1px solid #edf0f4">

                <span>
                    ${i+1}. ${p.icon} ${p.name}
                </span>

                <strong>
                    ${rupiah(productCost(p))}
                </strong>

            </div>

        `).join("");

}


/* ============================================================
   VIDEO / SHARE
============================================================ */

function createJourneyVideo(){

    openSimpleModal(
        "🎬 Journey Video Demo",
        `
        <div style="
            background:linear-gradient(135deg,#091a2f,#416278);
            border-radius:16px;
            padding:45px 25px;
            color:white;
            text-align:center">

            <div style="font-size:55px">🎬</div>

            <h2 style="margin:12px 0">
                AI Journey Story
            </h2>

            <p style="color:#d8e4ee;line-height:1.6">
                Destination → Itinerary → Scene →
                Narration → Cost → Travel Story
            </p>

        </div>

        <button
            class="btn btn-primary"
            style="width:100%;margin-top:18px"
            onclick="toast('Video generation demo started');closeModal()">
            Generate Demo Video
        </button>
        `
    );

}

function shareJourney(){

    openSimpleModal(
        "🔗 Share My Journey",
        `
        <p style="color:#718096;line-height:1.6">
            In the production version, HobbiGo can connect
            journey sharing with social and messaging platforms.
        </p>

        <div style="
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:10px;
            margin-top:18px">

            <button class="btn btn-outline"
                onclick="toast('Demo Link copied')">
                🔗 Copy Link
            </button>

            <button class="btn btn-outline"
                onclick="toast('WhatsApp share demo')">
                💬 WhatsApp
            </button>

            <button class="btn btn-outline"
                onclick="toast('Facebook share demo')">
                Facebook
            </button>

            <button class="btn btn-outline"
                onclick="toast('TikTok share demo')">
                TikTok
            </button>

        </div>
        `
    );

}


/* ============================================================
   GENERIC MODAL
============================================================ */

function openSimpleModal(title,body){

    document.getElementById("modalTitle").textContent=title;
    document.getElementById("modalBody").innerHTML=body;

    document.getElementById("modal")
        .classList.add("show");

}


/* ============================================================
   INITIALIZATION
============================================================ */

document.addEventListener("DOMContentLoaded",()=>{

    const today =
        new Date().toISOString().split("T")[0];

    document.getElementById("startDate").value=today;

    renderMarketplace();
    updateBudget();

    document.getElementById("nav-home")
        .classList.add("active");

});

</script>

</body>
</html>
