<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HobbiGo V78.0 — AI Journey & Experience Marketplace</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --navy:#071426;
    --navy2:#0d2038;
    --gold:#d6a84f;
    --gold2:#f3d27c;
    --white:#ffffff;
    --muted:#94a3b8;
    --bg:#f5f7fb;
    --card:#ffffff;
    --green:#16a34a;
    --red:#dc2626;
    --blue:#2563eb;
    --shadow:0 12px 35px rgba(7,20,38,.10);
    --radius:20px;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:var(--bg);
    color:#172033;
}

button,input,select{
    font:inherit;
}

button{
    cursor:pointer;
}

.topbar{
    background:var(--navy);
    color:white;
    height:34px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    letter-spacing:.5px;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(7,20,38,.96);
    backdrop-filter:blur(12px);
    color:white;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.nav{
    max-width:1400px;
    margin:auto;
    height:72px;
    display:flex;
    align-items:center;
    padding:0 24px;
    gap:28px;
}

.logo{
    font-weight:900;
    font-size:25px;
    letter-spacing:1.5px;
    color:white;
    min-width:150px;
}

.logo span{
    color:var(--gold2);
}

.navlinks{
    display:flex;
    gap:5px;
    flex:1;
    overflow:auto;
}

.navlinks button{
    border:0;
    background:transparent;
    color:#dbe5f3;
    padding:10px 12px;
    border-radius:10px;
    white-space:nowrap;
    font-size:13px;
}

.navlinks button:hover,
.navlinks button.active{
    background:rgba(255,255,255,.10);
    color:var(--gold2);
}

.nav-actions{
    display:flex;
    align-items:center;
    gap:10px;
}

.nav-user{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--gold),#fff0b5);
    color:#182235;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
}

.container{
    max-width:1400px;
    margin:auto;
    padding:30px 24px 70px;
}

.page{
    display:none;
}

.page.active{
    display:block;
    animation:fadeIn .25s ease;
}

@keyframes fadeIn{
    from{opacity:0;transform:translateY(5px)}
    to{opacity:1;transform:translateY(0)}
}

/* HERO */

.hero{
    min-height:560px;
    border-radius:30px;
    overflow:hidden;
    position:relative;
    background:
        linear-gradient(90deg,rgba(4,14,28,.94),rgba(4,14,28,.62),rgba(4,14,28,.18)),
        linear-gradient(135deg,#123c55,#6b4b2b);
    display:flex;
    align-items:center;
    padding:70px;
    color:white;
    box-shadow:var(--shadow);
}

.hero-content{
    max-width:720px;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 13px;
    border:1px solid rgba(243,210,124,.4);
    border-radius:30px;
    color:var(--gold2);
    background:rgba(255,255,255,.06);
    font-size:13px;
    margin-bottom:22px;
}

.hero h1{
    font-size:clamp(42px,6vw,76px);
    line-height:1;
    margin-bottom:22px;
}

.hero h1 span{
    color:var(--gold2);
}

.hero p{
    color:#d7e0ec;
    line-height:1.7;
    font-size:17px;
    max-width:650px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    margin-top:30px;
    flex-wrap:wrap;
}

.btn{
    border:0;
    border-radius:12px;
    padding:13px 20px;
    font-weight:750;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-1px);
}

.btn-primary{
    background:var(--gold);
    color:#172033;
}

.btn-dark{
    background:#0b1c30;
    color:white;
}

.btn-outline{
    background:transparent;
    border:1px solid #d8dee8;
    color:#172033;
}

.hero .btn-outline{
    color:white;
    border-color:rgba(255,255,255,.35);
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-top:20px;
}

.stat{
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.12);
    border-radius:16px;
    padding:16px;
}

.stat strong{
    display:block;
    font-size:23px;
    color:var(--gold2);
}

.stat small{
    color:#c6d1df;
}

/* SECTIONS */

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin:35px 0 18px;
}

.section-title h2{
    font-size:28px;
}

.section-title p{
    color:#718096;
    font-size:14px;
}

.card{
    background:var(--card);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    border:1px solid #e8edf4;
}

.card-pad{
    padding:22px;
}

/* QUICK FLOW */

.flow{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:10px;
}

.flow-item{
    padding:16px 10px;
    text-align:center;
    border-radius:15px;
    background:white;
    box-shadow:0 5px 20px rgba(7,20,38,.06);
    border:1px solid #e7ecf3;
}

.flow-item .icon{
    font-size:25px;
    margin-bottom:7px;
}

.flow-item strong{
    font-size:12px;
}

/* PLANNER */

.planner-layout{
    display:grid;
    grid-template-columns:1.7fr .9fr;
    gap:22px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.field label{
    display:block;
    font-size:12px;
    font-weight:800;
    color:#5d6879;
    margin-bottom:7px;
}

.field input,
.field select{
    width:100%;
    border:1px solid #dce3ec;
    background:white;
    border-radius:11px;
    padding:13px;
    outline:none;
}

.field input:focus,
.field select:focus{
    border-color:var(--gold);
}

.mode-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:18px;
}

.mode{
    border:1px solid #dce3ec;
    padding:15px;
    border-radius:14px;
    background:white;
    text-align:left;
}

.mode.active{
    border-color:var(--gold);
    background:#fffaf0;
}

.mode strong{
    display:block;
    margin-bottom:4px;
}

.mode small{
    color:#758196;
}

/* BUDGET */

.budget-card{
    background:linear-gradient(145deg,#0a1a2e,#102b47);
    color:white;
    padding:24px;
    border-radius:20px;
}

.budget-value{
    font-size:30px;
    color:var(--gold2);
    font-weight:900;
    margin:7px 0;
}

.progress{
    height:9px;
    background:rgba(255,255,255,.13);
    border-radius:20px;
    overflow:hidden;
    margin:15px 0;
}

.progress div{
    height:100%;
    width:0%;
    background:var(--gold);
}

.budget-row{
    display:flex;
    justify-content:space-between;
    padding:8px 0;
    border-bottom:1px solid rgba(255,255,255,.08);
    font-size:13px;
}

.budget-row:last-child{
    border-bottom:0;
}

/* MARKETPLACE */

.filterbar{
    display:flex;
    gap:8px;
    overflow:auto;
    margin-bottom:18px;
    padding-bottom:4px;
}

.filter{
    white-space:nowrap;
    border:1px solid #dce3ec;
    background:white;
    border-radius:30px;
    padding:9px 15px;
    font-size:13px;
}

.filter.active{
    background:var(--navy);
    color:white;
    border-color:var(--navy);
}

.product-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.product{
    overflow:hidden;
    position:relative;
}

.product-img{
    height:170px;
    background:linear-gradient(135deg,#d8c3a5,#7d9ba7);
    position:relative;
}

.product-img.hotel{background:linear-gradient(135deg,#7f9eae,#263f4d)}
.product-img.flight{background:linear-gradient(135deg,#9ebbd1,#28465e)}
.product-img.villa{background:linear-gradient(135deg,#8db18d,#31533b)}
.product-img.restaurant{background:linear-gradient(135deg,#d39c67,#533622)}
.product-img.activity{background:linear-gradient(135deg,#d9ad69,#405e42)}
.product-img.attraction{background:linear-gradient(135deg,#c99b63,#526d58)}
.product-img.transport{background:linear-gradient(135deg,#a7a9ab,#30363d)}
.product-img.boat{background:linear-gradient(135deg,#8cc5d8,#174b62)}
.product-img.ticket{background:linear-gradient(135deg,#c7a9d7,#4e3562)}

.product-img:after{
    content:"HOBBIGO";
    position:absolute;
    bottom:10px;
    left:12px;
    color:white;
    font-weight:900;
    letter-spacing:1px;
    opacity:.8;
}

.badge{
    position:absolute;
    top:10px;
    right:10px;
    background:white;
    border-radius:20px;
    padding:5px 9px;
    font-size:10px;
    font-weight:800;
}

.product-body{
    padding:16px;
}

.product-body h3{
    font-size:16px;
    margin-bottom:6px;
}

.product-meta{
    color:#718096;
    font-size:12px;
    margin-bottom:10px;
}

.price{
    color:#172033;
    font-weight:900;
    font-size:17px;
}

.product-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:14px;
    gap:7px;
}

/* PICK */

.pick-layout{
    display:grid;
    grid-template-columns:1fr 350px;
    gap:22px;
}

.selection-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.selected-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:15px;
    background:white;
    border:1px solid #e5eaf1;
    border-radius:15px;
}

.selected-info{
    display:flex;
    align-items:center;
    gap:13px;
}

.mini-icon{
    width:44px;
    height:44px;
    border-radius:12px;
    background:#edf2f7;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}

/* ROUTE */

.route{
    position:relative;
    margin:20px 0;
}

.route:before{
    content:"";
    position:absolute;
    left:23px;
    top:25px;
    bottom:25px;
    width:2px;
    background:#d9e0e9;
}

.route-item{
    position:relative;
    display:flex;
    gap:15px;
    margin-bottom:17px;
}

.route-dot{
    width:48px;
    height:48px;
    border-radius:50%;
    background:var(--navy);
    color:var(--gold2);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:2;
    flex:none;
}

.route-box{
    flex:1;
    background:white;
    border:1px solid #e2e8f0;
    padding:15px;
    border-radius:14px;
}

/* SUMMARY */

.summary-grid{
    display:grid;
    grid-template-columns:1.4fr .8fr;
    gap:20px;
}

.cost-row{
    display:flex;
    justify-content:space-between;
    padding:12px 0;
    border-bottom:1px solid #edf0f4;
}

.cost-row.total{
    font-size:20px;
    font-weight:900;
    border-bottom:0;
    padding-top:18px;
}

.cost-row.total span:last-child{
    color:#b07d16;
}

.package-box{
    background:linear-gradient(145deg,#0a1b2f,#173b59);
    color:white;
    border-radius:22px;
    padding:25px;
}

.package-box h3{
    color:var(--gold2);
    font-size:25px;
}

.package-feature{
    display:flex;
    gap:9px;
    margin:12px 0;
    color:#d8e3ef;
}

/* CART */

.cart-grid{
    display:grid;
    grid-template-columns:1.5fr .7fr;
    gap:20px;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px;
    border-bottom:1px solid #edf0f4;
}

.cart-item:last-child{
    border-bottom:0;
}

/* BOOKING */

.steps{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-bottom:20px;
}

.step{
    padding:13px;
    border-radius:12px;
    background:white;
    text-align:center;
    border:1px solid #e2e8f0;
    font-size:12px;
}

.step.done{
    background:#effaf2;
    border-color:#b8e0c3;
    color:#15803d;
}

.payment-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.payment{
    padding:20px;
    border:1px solid #dce3ec;
    border-radius:15px;
    background:white;
}

.payment.active{
    border:2px solid var(--gold);
    background:#fffaf0;
}

/* JOURNEY */

.journey-head{
    background:linear-gradient(135deg,#08172a,#163b58);
    color:white;
    padding:30px;
    border-radius:22px;
    margin-bottom:20px;
}

.journey-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.journey-card{
    padding:22px;
    min-height:170px;
}

.big-icon{
    font-size:38px;
    margin-bottom:15px;
}

/* SYSTEM */

.system-map{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    padding:30px;
}

.system-node{
    width:min(600px,100%);
    padding:18px;
    border-radius:15px;
    text-align:center;
    background:white;
    border:1px solid #dfe6ef;
    box-shadow:0 5px 20px rgba(7,20,38,.06);
    font-weight:800;
}

.system-node.main{
    background:var(--navy);
    color:white;
}

.system-node.gold{
    background:#fff7e5;
    border-color:#e9c66f;
}

.arrow{
    color:#a57b25;
    font-size:22px;
}

/* AI PANEL */

.ai-panel{
    background:linear-gradient(135deg,#101c34,#172e4a);
    color:white;
    border-radius:20px;
    padding:22px;
}

.ai-label{
    color:var(--gold2);
    font-weight:900;
    font-size:12px;
    letter-spacing:1px;
    margin-bottom:10px;
}

.ai-message{
    line-height:1.65;
    color:#dbe5f2;
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    background:rgba(3,10,20,.68);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:3000;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(620px,100%);
    max-height:90vh;
    overflow:auto;
    background:white;
    border-radius:22px;
    padding:25px;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.close{
    border:0;
    background:#eef2f7;
    width:35px;
    height:35px;
    border-radius:50%;
}

/* TOAST */

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:5000;
    background:#0a1a2d;
    color:white;
    padding:14px 18px;
    border-radius:12px;
    box-shadow:var(--shadow);
    transform:translateY(100px);
    opacity:0;
    transition:.3s;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* FOOTER */

footer{
    background:var(--navy);
    color:white;
    padding:40px 24px;
}

.footer-inner{
    max-width:1400px;
    margin:auto;
    display:grid;
    grid-template-columns:1.5fr 1fr 1fr 1fr;
    gap:30px;
}

.footer-inner h3{
    color:var(--gold2);
    margin-bottom:12px;
}

.footer-inner p,
.footer-inner li{
    color:#9eb0c4;
    font-size:13px;
    line-height:1.8;
    list-style:none;
}

/* RESPONSIVE */

@media(max-width:1100px){
    .product-grid{
        grid-template-columns:repeat(3,1fr);
    }

    .flow{
        grid-template-columns:repeat(4,1fr);
    }

    .planner-layout,
    .summary-grid,
    .cart-grid,
    .pick-layout{
        grid-template-columns:1fr;
    }

    .footer-inner{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:760px){
    .nav{
        padding:0 12px;
        gap:10px;
    }

    .logo{
        min-width:auto;
        font-size:19px;
    }

    .navlinks{
        display:none;
    }

    .container{
        padding:18px 12px 50px;
    }

    .hero{
        min-height:620px;
        padding:35px 24px;
    }

    .hero h1{
        font-size:43px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .form-grid,
    .mode-grid,
    .product-grid,
    .payment-grid,
    .journey-grid{
        grid-template-columns:1fr;
    }

    .flow{
        grid-template-columns:repeat(2,1fr);
    }

    .steps{
        grid-template-columns:repeat(2,1fr);
    }

    .footer-inner{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<div class="topbar">
    HOBBIGO V78.0 • AI JOURNEY & EXPERIENCE MARKETPLACE • FULL INVESTOR DEMO
</div>

<header>
    <div class="nav">
        <div class="logo">HOBBI<span>GO</span></div>

        <div class="navlinks">
            <button onclick="showPage('home')" id="nav-home">Home</button>
            <button onclick="showPage('planner')" id="nav-planner">Plan</button>
            <button onclick="showPage('marketplace')" id="nav-marketplace">Marketplace</button>
            <button onclick="showPage('pick')" id="nav-pick">Pick</button>
            <button onclick="showPage('route')" id="nav-route">Route</button>
            <button onclick="showPage('package')" id="nav-package">Package</button>
            <button onclick="showPage('cart')" id="nav-cart">Cart</button>
            <button onclick="showPage('booking')" id="nav-booking">Booking</button>
            <button onclick="showPage('mytrip')" id="nav-mytrip">My Trip</button>
            <button onclick="showPage('system')" id="nav-system">System</button>
        </div>

        <div class="nav-actions">
            <div class="nav-user">HG</div>
        </div>
    </div>
</header>

<main class="container">

<!-- ================= HOME ================= -->

<section id="home" class="page active">

    <div class="hero">

        <div class="hero-content">

            <div class="eyebrow">
                ✦ AI JOURNEY & EXPERIENCE MARKETPLACE
            </div>

            <h1>
                Travel your way.<br>
                <span>Powered by AI.</span>
            </h1>

            <p>
                HobbiGo brings planning, marketplace, smart routing,
                budgeting, booking and travel experiences into one connected
                journey platform.
            </p>

            <div class="hero-buttons">
                <button class="btn btn-primary" onclick="showPage('planner')">
                    ✦ Start Planning
                </button>

                <button class="btn btn-outline" onclick="showPage('marketplace')">
                    Explore Marketplace
                </button>
            </div>

            <div class="stats">
                <div class="stat">
                    <strong>AI</strong>
                    <small>Trip Planning</small>
                </div>

                <div class="stat">
                    <strong>∞</strong>
                    <small>Marketplace</small>
                </div>

                <div class="stat">
                    <strong>1</strong>
                    <small>Journey Platform</small>
                </div>

                <div class="stat">
                    <strong>24/7</strong>
                    <small>Travel Ecosystem</small>
                </div>
            </div>

        </div>
    </div>

    <div class="section-title">
        <div>
            <h2>How HobbiGo Works</h2>
            <p>One journey from idea to experience.</p>
        </div>
    </div>

    <div class="flow">

        <div class="flow-item">
            <div class="icon">🔎</div>
            <strong>Search</strong>
        </div>

        <div class="flow-item">
            <div class="icon">🤖</div>
            <strong>AI Plan</strong>
        </div>

        <div class="flow-item">
            <div class="icon">🛍️</div>
            <strong>Marketplace</strong>
        </div>

        <div class="flow-item">
            <div class="icon">🧭</div>
            <strong>Smart Route</strong>
        </div>

        <div class="flow-item">
            <div class="icon">📦</div>
            <strong>Package</strong>
        </div>

        <div class="flow-item">
            <div class="icon">💳</div>
            <strong>Book</strong>
        </div>

        <div class="flow-item">
            <div class="icon">🎬</div>
            <strong>Experience</strong>
        </div>

    </div>

    <div class="section-title">
        <div>
            <h2>Choose Your Journey Mode</h2>
            <p>Customers remain in control.</p>
        </div>
    </div>

    <div class="journey-grid">

        <div class="card journey-card">
