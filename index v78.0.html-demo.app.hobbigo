<!-- ================= PLANNER ================= -->

<section id="planner" class="page">

    <div class="section-title">
        <div>
            <h2>AI Trip Planner</h2>
            <p>Create your journey configuration.</p>
        </div>
    </div>

    <div class="planner-layout">

        <div class="card card-pad">

            <div class="form-grid">

                <div class="field">
                    <label>CUSTOMER TYPE</label>
                    <select id="customerType">
                        <option>Personal</option>
                        <option>Family</option>
                        <option>Group</option>
                        <option>Corporate</option>
                    </select>
                </div>

                <div class="field">
                    <label>DESTINATION</label>
                    <input id="destination" value="Bali, Indonesia">
                </div>

                <div class="field">
                    <label>START DATE</label>
                    <input id="startDate" type="date">
                </div>

                <div class="field">
                    <label>TRAVELERS</label>
                    <input id="travelers" type="number" min="1" value="2">
                </div>

                <div class="field">
                    <label>DURATION</label>
                    <select id="duration">
                        <option>3 Days / 2 Nights</option>
                        <option>4 Days / 3 Nights</option>
                        <option>5 Days / 4 Nights</option>
                        <option>7 Days / 6 Nights</option>
                    </select>
                </div>

                <div class="field">
                    <label>BUDGET</label>
                    <input id="budget" type="number" value="15000000">
                </div>

                <div class="field">
                    <label>TRIP STYLE</label>
                    <select id="style">
                        <option>Comfort</option>
                        <option>Economy</option>
                        <option>Exclusive</option>
                        <option>Best Price</option>
                    </select>
                </div>

                <div class="field">
                    <label>MAIN INTEREST</label>
                    <select id="interest">
                        <option>Nature</option>
                        <option>Culinary</option>
                        <option>Adventure</option>
                        <option>Culture</option>
                        <option>Relaxation</option>
                        <option>Family</option>
                        <option>Business</option>
                    </select>
                </div>

            </div>

            <div style="margin-top:20px">
                <strong>Planning Mode</strong>

                <div class="mode-grid">

                    <button class="mode active" id="mode-ai"
                            onclick="setMode('AI Plan')">
                        <strong>🤖 AI PLAN</strong>
                        <small>AI builds the initial journey.</small>
