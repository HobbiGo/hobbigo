                    <button class="mode" id="mode-manual"
                            onclick="setMode('Manual Pick')">
                        <strong>🖱️ MANUAL PICK</strong>
                        <small>Choose products yourself.</small>
                    </button>

                    <button class="mode" id="mode-hybrid"
                            onclick="setMode('AI + Manual')">
                        <strong>⚡ AI + MANUAL</strong>
                        <small>AI + customer customization.</small>
                    </button>

                </div>
            </div>

            <button class="btn btn-primary"
                    style="margin-top:22px;width:100%"
