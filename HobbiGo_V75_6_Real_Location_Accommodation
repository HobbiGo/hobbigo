function loadGoogleMaps(){

    if(
        !GOOGLE_MAPS_API_KEY ||
        GOOGLE_MAPS_API_KEY ===
        "YOUR_GOOGLE_MAPS_API_KEY"
    ){

        document.getElementById(
            "mapStatus"
        ).textContent =
            "Google Maps API Key Required";

        return;

    }

    if(
        document.querySelector(
            'script[data-hobbigo-google="true"]'
        )
    ){
        return;
    }

    const script =
        document.createElement("script");

    script.dataset.hobbigoGoogle = "true";

    script.src =
        "https://maps.googleapis.com/maps/api/js?key=" +
        encodeURIComponent(
            GOOGLE_MAPS_API_KEY
        ) +
        "&libraries=places&callback=initGoogleMap";

    script.async = true;
    script.defer = true;

    document.head.appendChild(script);

}


window.initGoogleMap = function(){

    googleReady = true;

    document.getElementById(
        "mapStatus"
    ).textContent =
        "Google Maps Connected";

    initGoogleMap();

};


function initGoogleMap(){

    if(
        typeof google === "undefined" ||
        !google.maps
    ){
        return;
    }

    const stop =
        currentJourney.stops[0];

    map =
        new google.maps.Map(
            document.getElementById("map"),
            {
                center:{
                    lat:stop.lat,
                    lng:stop.lng
                },
                zoom:10,
                mapTypeControl:false,
                streetViewControl:false,
                fullscreenControl:true
            }
        );

    renderMapJourney();

}


function clearMapMarkers(){

    mapMarkers.forEach(
        marker=>{
            marker.setMap(null);
        }
    );

    mapMarkers = [];

}


function renderMapJourney(){

    renderStops();

    if(
        !map ||
        typeof google === "undefined"
    ){
        return;
    }

    clearMapMarkers();

    const path =
        currentJourney.stops.map(
            stop=>({
                lat:stop.lat,
                lng:stop.lng
            })
        );

    currentJourney.stops.forEach(
        (stop,index)=>{

            const marker =
                new google.maps.Marker({
                    position:{
                        lat:stop.lat,
                        lng:stop.lng
                    },
                    map:map,
                    title:
                        "Day " +
                        stop.day +
                        " - " +
                        stop.name,
                    label:String(index+1)
                });

            mapMarkers.push(marker);

        }
    );

    if(journeyPolyline){
        journeyPolyline.setMap(null);
    }

    journeyPolyline =
        new google.maps.Polyline({
            path:path,
            geodesic:true,
            strokeOpacity:.8,
            strokeWeight:4,
            map:map
        });

    map.fitBounds(
        new google.maps.LatLngBounds(
            path.reduce(
                (bounds,point)=>{
                    bounds.extend(point);
                    return bounds;
                },
                new google.maps.LatLngBounds()
            )
        )
    );

}


function openGoogleDirections(){

    const stops =
        currentJourney.stops;

    if(!stops.length) return;

    const origin =
        stops[0].lat +
        "," +
        stops[0].lng;

    const destination =
        stops[stops.length-1].lat +
        "," +
        stops[stops.length-1].lng;

    const waypoints =
        stops
        .slice(1,-1)
        .map(
            s=>s.lat + "," + s.lng
        )
        .join("|");

    let url =
        "https://www.google.com/maps/dir/?api=1" +
        "&origin=" +
        encodeURIComponent(origin) +
        "&destination=" +
        encodeURIComponent(destination);

    if(waypoints){

        url +=
            "&waypoints=" +
            encodeURIComponent(waypoints);

    }

    window.open(
        url,
        "_blank"
    );

}


