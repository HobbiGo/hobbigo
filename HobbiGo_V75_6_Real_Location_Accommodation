<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HobbiGo V75.6 - Real Location Accommodation Engine</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#07111f;
    color:#f5f7fb;
    line-height:1.5;
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.container{
    width:min(1400px,94%);
    margin:auto;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,12,24,.94);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(255,255,255,.08);
}

.nav{
    min-height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:.5px;
}

.logo span{
    color:#35d8ff;
}

.navlinks{
    display:flex;
    gap:18px;
    flex-wrap:wrap;
}

.navlinks a{
    color:#b8c7d9;
    text-decoration:none;
    font-size:14px;
}

.navlinks a:hover{
    color:#35d8ff;
}

.cartBtn{
    border:1px solid rgba(53,216,255,.35);
    background:rgba(53,216,255,.08);
    color:#fff;
    padding:10px 16px;
    border-radius:12px;
}

.hero{
    min-height:470px;
    display:flex;
    align-items:center;
    background:
        linear-gradient(90deg,rgba(3,10,20,.96),rgba(3,10,20,.55)),
        url("https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=1800&q=85")
        center/cover;
}

.heroContent{
    max-width:800px;
    padding:70px 0;
}

.badge{
    display:inline-block;
    padding:7px 12px;
    border:1px solid rgba(53,216,255,.35);
    border-radius:999px;
    background:rgba(53,216,255,.08);
    color:#35d8ff;
    font-size:12px;
    font-weight:bold;
    margin-bottom:18px;
}

h1{
    font-size:clamp(38px,6vw,70px);
    line-height:1.03;
    margin-bottom:20px;
}

.gradient{
    background:linear-gradient(90deg,#35d8ff,#7c7cff,#b86cff);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    color:#c0ccda;
    font-size:18px;
    max-width:720px;
}

.searchBox{
    margin-top:-42px;
    position:relative;
    z-index:10;
}

.searchPanel{
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.1);
    border-radius:20px;
    padding:20px;
    box-shadow:0 25px 60px rgba(0,0,0,.35);
}

.searchGrid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr auto;
    gap:12px;
}

.field{
    display:flex;
    flex-direction:column;
    gap:6px;
}

.field label{
    font-size:11px;
    color:#8ea3b8;
    text-transform:uppercase;
    letter-spacing:.7px;
}

.field input,
.field select{
    width:100%;
    padding:13px;
    border-radius:11px;
    border:1px solid rgba(255,255,255,.1);
    background:#081321;
    color:#fff;
    outline:none;
}

.field input:focus,
.field select:focus{
    border-color:#35d8ff;
}

.primary{
    border:0;
    border-radius:12px;
    padding:13px 18px;
    background:linear-gradient(90deg,#19bfe7,#675cff);
    color:white;
    font-weight:bold;
}

.secondary{
    border:1px solid rgba(255,255,255,.13);
    border-radius:11px;
    padding:10px 14px;
    background:#101f32;
    color:#fff;
}

.section{
    padding:65px 0;
}

.sectionTitle{
    margin-bottom:28px;
}

.sectionTitle h2{
    font-size:32px;
    margin-bottom:7px;
}

.sectionTitle p{
    color:#8fa3b8;
}

.journeyGrid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.journeyCard{
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    overflow:hidden;
    transition:.2s;
}

.journeyCard:hover{
    transform:translateY(-3px);
    border-color:rgba(53,216,255,.35);
}

.journeyImage{
    height:190px;
    background-size:cover;
    background-position:center;
}

.journeyBody{
    padding:18px;
}

.journeyBody h3{
    margin-bottom:7px;
}

.journeyBody p{
    color:#92a5b8;
    font-size:14px;
    margin-bottom:14px;
}

.mapLayout{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:20px;
}

.mapBox{
    min-height:540px;
    border-radius:20px;
    overflow:hidden;
    background:#0c1726;
    border:1px solid rgba(255,255,255,.1);
    position:relative;
}

#map{
    width:100%;
    height:540px;
}

.mapFallback{
    height:100%;
    min-height:540px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px;
    color:#9db0c4;
}

.mapStatus{
    position:absolute;
    top:15px;
    left:15px;
    z-index:10;
    background:rgba(4,12,23,.88);
    border:1px solid rgba(255,255,255,.1);
    border-radius:10px;
    padding:9px 12px;
    font-size:12px;
}

.locationPanel{
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:20px;
    padding:20px;
}

.locationPanel h3{
    margin-bottom:7px;
}

.muted{
    color:#8ea3b8;
    font-size:14px;
}

.currentJourney{
    margin:16px 0;
    padding:15px;
    border-radius:13px;
    background:#081321;
    border:1px solid rgba(255,255,255,.07);
}

.stopList{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-top:15px;
    max-height:390px;
    overflow:auto;
}

.stop{
    padding:13px;
    background:#101f32;
    border:1px solid rgba(255,255,255,.07);
    border-radius:12px;
}

.stop strong{
    display:block;
}

.stop small{
    color:#8197ac;
}

.accommodationToolbar{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:15px;
    margin-bottom:20px;
    flex-wrap:wrap;
}

.toolbarLeft{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.toolbarLeft select,
.toolbarLeft input{
    background:#0d1a2b;
    color:#fff;
    border:1px solid rgba(255,255,255,.1);
    padding:11px;
    border-radius:10px;
}

.resultsInfo{
    color:#8fa3b8;
    font-size:14px;
}

.hotelGrid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.hotelCard{
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    overflow:hidden;
    display:flex;
    flex-direction:column;
}

.hotelImage{
    height:190px;
    background:#111d2d;
    background-size:cover;
    background-position:center;
}

.hotelBody{
    padding:17px;
    display:flex;
    flex-direction:column;
    gap:8px;
    flex:1;
}

.hotelTop{
    display:flex;
    justify-content:space-between;
    gap:10px;
}

.hotelName{
    font-size:18px;
    font-weight:bold;
}

.rating{
    color:#ffd166;
    white-space:nowrap;
    font-size:13px;
}

.hotelLocation{
    color:#8fa3b8;
    font-size:13px;
}

.distance{
    color:#35d8ff;
    font-size:13px;
}

.hotelTags{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
}

.tag{
    padding:4px 8px;
    border-radius:999px;
    background:#14253a;
    color:#a9bfd4;
    font-size:11px;
}

.hotelBottom{
    display:flex;
    justify-content:space-between;
    align-items:end;
    margin-top:auto;
    padding-top:10px;
}

.price{
    font-size:18px;
    font-weight:bold;
}

.price small{
    color:#8297ab;
    font-size:11px;
    font-weight:normal;
}

.cardActions{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    margin-top:10px;
}

.cardActions button{
    flex:1;
    min-width:90px;
}

.empty{
    padding:35px;
    text-align:center;
    background:#0d1a2b;
    border:1px dashed rgba(255,255,255,.12);
    border-radius:15px;
    color:#91a5b8;
}

.packageBox{
    background:linear-gradient(135deg,#0d1a2b,#101c35);
    border:1px solid rgba(53,216,255,.15);
    border-radius:20px;
    padding:24px;
}

.packageItems{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin:20px 0;
}

.packageItem{
    display:flex;
    justify-content:space-between;
    gap:15px;
    padding:13px;
    background:#081321;
    border-radius:11px;
}

.cartLayout{
    display:grid;
    grid-template-columns:1fr 360px;
    gap:20px;
}

.cartItems{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.cartItem{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    padding:15px;
    border-radius:13px;
}

.qty{
    display:flex;
    align-items:center;
    gap:8px;
}

.qty button{
    width:28px;
    height:28px;
    border-radius:7px;
    border:0;
    background:#17283d;
    color:#fff;
}

.summary{
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    padding:20px;
    height:max-content;
}

.summaryRow{
    display:flex;
    justify-content:space-between;
    margin:10px 0;
    color:#9eb1c4;
}

.summaryTotal{
    border-top:1px solid rgba(255,255,255,.1);
    padding-top:14px;
    margin-top:14px;
    display:flex;
    justify-content:space-between;
    font-size:20px;
    font-weight:bold;
}

.bookingBox{
    max-width:800px;
    margin:auto;
    background:#0d1a2b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:20px;
    padding:25px;
}

.bookingGrid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:13px;
    margin:18px 0;
}

.bookingGrid input,
.bookingGrid select{
    width:100%;
    padding:13px;
    border-radius:10px;
    border:1px solid rgba(255,255,255,.1);
    background:#081321;
    color:#fff;
}

footer{
    border-top:1px solid rgba(255,255,255,.08);
    padding:30px 0;
    color:#73879c;
    text-align:center;
    font-size:13px;
}

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:5000;
    background:#122238;
    border:1px solid rgba(53,216,255,.35);
    color:#fff;
    padding:13px 16px;
    border-radius:12px;
    box-shadow:0 15px 40px rgba(0,0,0,.35);
    opacity:0;
    transform:translateY(20px);
    pointer-events:none;
    transition:.25s;
}

.toast.show{
    opacity:1;
    transform:translateY(0);
}

@media(max-width:1050px){
    .searchGrid{
        grid-template-columns:1fr 1fr;
    }

    .journeyGrid,
    .hotelGrid{
        grid-template-columns:repeat(2,1fr);
    }

    .mapLayout{
        grid-template-columns:1fr;
    }
}

@media(max-width:700px){
    .navlinks{
        display:none;
    }

    .searchGrid,
    .journeyGrid,
    .hotelGrid,
    .cartLayout,
    .bookingGrid{
        grid-template-columns:1fr;
    }

    .hero{
        min-height:430px;
    }

    h1{
        font-size:42px;
    }

    .section{
        padding:45px 0;
    }
}
</style>
</head>

<body>

<header>
<div class="container nav">

    <div class="logo">
        Hobbi<span>Go</span>
    </div>

    <nav class="navlinks">
        <a href="#home">Home</a>
        <a href="#journeys">Journey</a>
        <a href="#mapSection">Map</a>
        <a href="#accommodation">Accommodation</a>
        <a href="#marketplace">Marketplace</a>
        <a href="#cart">Cart</a>
    </nav>

    <button class="cartBtn" onclick="go('cart')">
        🛒 Cart <span id="cartCount">0</span>
    </button>

</div>
</header>


<section class="hero" id="home">

<div class="container heroContent">

    <span class="badge">
        V75.6 • REAL LOCATION ACCOMMODATION ENGINE
    </span>

    <h1>
        Your Journey.<br>
        <span class="gradient">Real Places. Real Map.</span>
    </h1>

    <p>
        Discover real accommodation around every journey stop.
        HobbiGo connects Journey, Google Maps, location intelligence
        and global marketplace products in one travel flow.
    </p>

</div>

</section>


<section class="searchBox">

<div class="container">

<div class="searchPanel">

<div class="searchGrid">

    <div class="field">
        <label>Destination / Location</label>
        <input
            id="destinationInput"
            value="Bali, Indonesia"
            placeholder="Example: Bali, Japan, Paris..."
        >
    </div>

    <div class="field">
        <label>Date</label>
        <input type="date" id="dateInput">
    </div>

    <div class="field">
        <label>Travelers</label>
        <input type="number" id="travelerInput" value="2" min="1">
    </div>

    <div class="field">
        <label>Duration</label>
        <select id="durationInput">
            <option value="3">3 Days</option>
            <option value="5" selected>5 Days</option>
            <option value="7">7 Days</option>
            <option value="10">10 Days</option>
            <option value="14">14 Days</option>
        </select>
    </div>

    <div class="field">
        <label>&nbsp;</label>
        <button class="primary" onclick="searchDestination()">
            🔎 Search
        </button>
    </div>

</div>

</div>

</div>

</section>


<section class="section" id="journeys">

<div class="container">

<div class="sectionTitle">
    <h2>Featured Global Journeys</h2>
