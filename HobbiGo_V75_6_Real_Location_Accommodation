function addPackageToCart(){

    if(!selectedAccommodation){

        toast(
            "Please select accommodation first."
        );

        go("accommodation");

        return;

    }

    const hotel =
        selectedAccommodation;

    const existing =
        cart.find(
            item=>
                item.id === hotel.id
        );

    if(existing){

        existing.qty += 1;

    }else{

        cart.push({

            id:hotel.id,

            name:hotel.name,

            type:"Accommodation",

            location:
                hotel.city,

            price:
                hotel.price || 0,

            currency:
                hotel.currency || "IDR",

            qty:1,

            image:
                hotel.image,

            source:
                hotel.source

        });

    }

    saveCart();

    renderCart();

    toast(
        hotel.name +
        " added to Cart"
    );

}


/* ---------------------------------------------------------
   CART
   --------------------------------------------------------- */

function renderCart(){

    const container =
        document.getElementById(
            "cartItems"
        );

    if(!cart.length){

        container.innerHTML =
            `<div class="empty">
                Your cart is empty.
            </div>`;

    }else{

        container.innerHTML =
            cart.map(
                item=>`

                <div class="cartItem">

                    <div>

                        <strong>
                            ${escapeHtml(item.name)}
                        </strong>

                        <div class="muted">
                            ${escapeHtml(item.type)}
                            •
                            ${escapeHtml(item.location)}
                        </div>

                        <div>
                            ${
                                item.price
                                ?
                                money(
                                    item.price,
                                    item.currency
                                )
                                :
                                "Supplier price pending"
                            }
                        </div>

                    </div>

                    <div class="qty">

                        <button
                            onclick="changeQty('${item.id}',-1)"
                        >
                            −
                        </button>

                        <span>
                            ${item.qty}
                        </span>

                        <button
                            onclick="changeQty('${item.id}',1)"
                        >
                            +
                        </button>

                        <button
                            onclick="removeCart('${item.id}')"
                        >
                            ✕
                        </button>

                    </div>

                </div>

                `
            ).join("");

    }

    const itemCount =
        cart.reduce(
            (sum,item)=>
                sum + item.qty,
            0
        );

    document.getElementById(
        "cartCount"
    ).textContent =
        itemCount;

    document.getElementById(
        "summaryItems"
    ).textContent =
        itemCount;

    /*
       IMPORTANT:
       V75.6 is still multi-currency ready.
       We do NOT pretend JPY/CHF/AUD/THB are IDR.
       Mixed currency totals are therefore marked
       as supplier/FX pending below.
    */

    const currencies =
        [...new Set(
            cart
            .map(
                item=>item.currency
            )
            .filter(Boolean)
        )];

    if(currencies.length <= 1){

        const currency =
            currencies[0] || "IDR";

        const subtotal =
            cart.reduce(
                (sum,item)=>
                    sum +
                    (
                        Number(item.price || 0) *
                        item.qty
                    ),
                0
            );

        const fee =
            subtotal * .03;

        document.getElementById(
            "summaryFee"
        ).textContent =
            money(
                fee,
                currency
            );

        document.getElementById(
            "summaryTotal"
        ).textContent =
            money(
                subtotal + fee,
                currency
            );

    }else{

        document.getElementById(
            "summaryFee"
        ).textContent =
            "FX engine pending";

        document.getElementById(
            "summaryTotal"
        ).textContent =
            "Multi-currency";

    }

    updateBookingSummary();

}


function changeQty(id,delta){

    const item =
        cart.find(
            item=>item.id === id
        );

    if(!item) return;

    item.qty += delta;

    if(item.qty <= 0){

        cart =
            cart.filter(
                item=>item.id !== id
            );

    }

    saveCart();

    renderCart();

}


function removeCart(id){

    cart =
        cart.filter(
            item=>item.id !== id
        );

    saveCart();

    renderCart();

    toast("Item removed");

}


/* ---------------------------------------------------------
   SEARCH DESTINATION
   --------------------------------------------------------- */

function searchDestination(){

    const query =
        document.getElementById(
            "destinationInput"
        ).value
        .trim()
        .toLowerCase();

    if(!query){

        toast(
            "Please enter destination."
        );

        return;

    }

    const match =
        journeys.find(
            journey=>
                (
                    journey.location +
                    " " +
                    journey.name
                )
                .toLowerCase()
                .includes(query)
        );

    if(match){

        selectJourney(match.id);

        return;

    }

    /*
       If no demo journey matches,
       show a real Google Maps search.
    */

    const url =
        "https://www.google.com/maps/search/?api=1&query=" +
        encodeURIComponent(
            document.getElementById(
                "destinationInput"
            ).value
        );

    window.open(
        url,
        "_blank"
    );

    toast(
        "Destination opened in Google Maps."
    );

}


/* ---------------------------------------------------------
   BOOKING
   --------------------------------------------------------- */

function updateBookingSummary(){

    const container =
        document.getElementById(
            "bookingSummary"
        );

    if(!cart.length){

        container.textContent =
            "No items selected.";

        return;

    }

    container.innerHTML = `

        <strong>
            ${currentJourney.name}
        </strong>

        <br>

        <span class="muted">
            ${cart.length} product type(s)
            •
            ${cart.reduce(
                (s,i)=>s+i.qty,
                0
            )} item(s)
        </span>

        <br><br>

        ${cart.map(
            item=>`

            <div style="
                display:flex;
                justify-content:space-between;
                margin:7px 0;
                gap:15px;
            ">

                <span>
                    ${escapeHtml(item.name)}
                    × ${item.qty}
                </span>

                <strong>
                    ${
                        item.price
                        ?
                        money(
                            item.price *
                            item.qty,
                            item.currency
                        )
                        :
                        "Supplier price"
                    }
                </strong>

            </div>

            `
        ).join("")}

    `;

}


function confirmBooking(){

    if(!cart.length){

        toast(
            "Cart is empty."
        );

        go("cart");

        return;

    }

    const booking = {

        id:
            "HB-" +
            Date.now(),

        journey:
            currentJourney.name,

        guest:
            document.getElementById(
                "guestName"
            ).value,

        email:
            document.getElementById(
                "guestEmail"
            ).value,

        phone:
            document.getElementById(
                "guestPhone"
            ).value,

        payment:
            document.getElementById(
                "paymentMethod"
            ).value,

        items:cart,

        createdAt:
            new Date().toISOString(),

        status:
            "DEMO_CONFIRMED"

    };

    localStorage.setItem(
        BOOKING_KEY,
        JSON.stringify(booking)
    );

    toast(
        "Demo booking confirmed: " +
        booking.id
    );

}


