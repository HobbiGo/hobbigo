function searchAccommodation(){

    const selector =
        document.getElementById("stopSelector");

    let index =
        selector.value;

    if(index === ""){

        index = 0;

        selector.value = 0;

    }

    const stop =
        currentJourney.stops[
            Number(index)
        ];

    if(!stop) return;

    if(
        googleReady &&
        typeof google !== "undefined" &&
        google.maps &&
        google.maps.places
    ){

        searchGoogleAccommodation(
            stop
        );

    }else{

        searchDemoAccommodation(
            stop
        );

    }

}


function searchGoogleAccommodation(stop){

    document.getElementById(
        "resultsInfo"
    ).textContent =
        "Searching real Google Maps places near " +
        stop.name + "...";

    const service =
        new google.maps.places.PlacesService(
            map
        );

    const radius =
        Number(
            document.getElementById(
                "radiusSelector"
            ).value
        );

    service.nearbySearch(
        {
            location:{
                lat:stop.lat,
                lng:stop.lng
            },

            radius:radius,

            type:"lodging"

        },

        function(results,status){

            if(
                status !==
                google.maps.places.PlacesServiceStatus.OK
            ){

                document.getElementById(
                    "resultsInfo"
                ).textContent =
                    "No live accommodation found. Showing fallback demo data.";

                searchDemoAccommodation(
                    stop
                );

                return;

            }

            accommodationResults =
                results.map(
                    place=>normalizeGooglePlace(
                        place,
                        stop
                    )
                );

            renderAccommodation();

            addAccommodationMarkers();

        }
    );

}


function normalizeGooglePlace(
    place,
    stop
){

    let image =
        "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80";

    if(
        place.photos &&
        place.photos.length
    ){

        image =
            place.photos[0].getUrl({
                maxWidth:900,
                maxHeight:600
            });

    }

    const lat =
        place.geometry &&
        place.geometry.location ?
        place.geometry.location.lat() :
        stop.lat;

    const lng =
        place.geometry &&
        place.geometry.location ?
        place.geometry.location.lng() :
        stop.lng;

    return {

        id:
            "google-" +
            place.place_id,

        name:
            place.name ||
            "Accommodation",

        city:
            place.vicinity ||
            currentJourney.location,

        lat:lat,

        lng:lng,

        rating:
            place.rating ||
            0,

        priceLevel:
            place.price_level,

        price:null,

        currency:"",

        image:image,

        tags:[
            "Google Maps",
            "Real Location"
        ],

        source:"Google Places",

        placeId:
            place.place_id,

        mapsUrl:
            "https://www.google.com/maps/search/?api=1&query=" +
            encodeURIComponent(
                place.name +
                " " +
                (place.vicinity || "")
            ) +
            "&query_place_id=" +
            encodeURIComponent(
                place.place_id || ""
            ),

        distance:
            distanceKm(
                stop.lat,
                stop.lng,
                lat,
                lng
            )

    };

}


function searchDemoAccommodation(stop){

    accommodationResults =
        demoHotels
        .map(
            hotel=>{

                return {
                    ...hotel,
                    distance:
                        distanceKm(
                            stop.lat,
                            stop.lng,
                            hotel.lat,
                            hotel.lng
                        )
                };

            }
        )
        .filter(
            hotel=>{

                const radius =
                    Number(
                        document.getElementById(
                            "radiusSelector"
                        ).value
                    );

                return (
                    hotel.distance * 1000
                ) <= radius;

            }
        );

    if(
        accommodationResults.length === 0
    ){

        accommodationResults =
            demoHotels
            .map(
                hotel=>({
                    ...hotel,
                    distance:
                        distanceKm(
                            stop.lat,
                            stop.lng,
                            hotel.lat,
                            hotel.lng
                        )
                })
            )
            .sort(
                (a,b)=>
                    a.distance-b.distance
            )
            .slice(0,6);

    }

    document.getElementById(
        "resultsInfo"
    ).textContent =
        "Demo location data. Add Google Maps API key for live Places results.";

    renderAccommodation();

}


