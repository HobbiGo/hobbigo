function escapeHtml(value){

    return String(value || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");

}


function viewAccommodation(id){

    const hotel =
        accommodationResults.find(
            h=>h.id === id
        );

    if(!hotel) return;

    if(hotel.mapsUrl){

        window.open(
            hotel.mapsUrl,
            "_blank"
        );

    }else if(
        hotel.lat &&
        hotel.lng
    ){

        const url =
            "https://www.google.com/maps/search/?api=1&query=" +
            encodeURIComponent(
                hotel.lat + "," + hotel.lng
            );

        window.open(
            url,
            "_blank"
        );

    }

}


function selectAccommodation(id){

    const hotel =
        accommodationResults.find(
            h=>h.id === id
        );

    if(!hotel) return;

    selectedAccommodation =
        hotel;

    renderPackage();

    toast(
        hotel.name +
        " added to Journey Package"
    );

    go("marketplace");

}


