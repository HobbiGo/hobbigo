                        position:{
                            lat:hotel.lat,
                            lng:hotel.lng
                        },
                        map:map,
                        title:hotel.name,
                        icon:{
                            url:
                                "https://maps.google.com/mapfiles/ms/icons/blue-dot.png"
                        }
                    });

                const info =
                    new google.maps.InfoWindow({
                        content:`

                        <div style="min-width:200px">

                            <strong>
                                ${escapeHtml(hotel.name)}
                            </strong>

                            <br>

                            ⭐ ${hotel.rating || "N/A"}

                            <br>

                            📏 ${
                                hotel.distance
                                ?
                                hotel.distance.toFixed(1)+" km"
                                :
                                ""
                            }

                        </div>

                        `
                    });

                marker.addListener(
                    "click",
                    ()=>{
                        info.open(
                            map,
                            marker
                        );
                    }
                );

                mapMarkers.push(marker);

            }
        );

}


/* ---------------------------------------------------------
   SORT
   --------------------------------------------------------- */

function sortHotels(){

    const mode =
        document.getElementById(
            "sortSelector"
        ).value;

    accommodationResults.sort(
        (a,b)=>{

            if(mode === "distance"){

                return (
                    (a.distance || 999) -
                    (b.distance || 999)
                );

            }

            if(mode === "rating"){

                return (
                    (b.rating || 0) -
                    (a.rating || 0)
                );

            }

            if(mode === "name"){

                return String(a.name)
                    .localeCompare(
                        String(b.name)
                    );

            }

            return 0;

        }
    );

    renderAccommodation();

}


