            🏨 Find Accommodation Near Journey
        </button>

    </div>

</div>

</div>

</section>


<section class="section" id="accommodation">

<div class="container">

<div class="sectionTitle">
    <h2>Real Accommodation Near Your Journey</h2>
    <p>
        Search hotels, villas and lodging around selected Journey locations.
    </p>
</div>

<div class="accommodationToolbar">

    <div class="toolbarLeft">

        <select id="stopSelector" onchange="searchAccommodation()">
            <option value="">Select Journey Stop</option>
        </select>

        <select id="radiusSelector" onchange="searchAccommodation()">
            <option value="2000">2 km</option>
            <option value="5000" selected>5 km</option>
            <option value="10000">10 km</option>
            <option value="25000">25 km</option>
        </select>

        <select id="sortSelector" onchange="sortHotels()">
            <option value="distance">Nearest</option>
            <option value="rating">Highest Rating</option>
            <option value="name">Name</option>
        </select>

    </div>

    <div class="resultsInfo" id="resultsInfo">
        Ready to search.
    </div>

</div>

<div id="hotelGrid" class="hotelGrid"></div>

</div>

</section>


<section class="section" id="marketplace">

<div class="container">

<div class="sectionTitle">
    <h2>HobbiGo Global Marketplace</h2>
    <p>
        Accommodation selected from location search can become part of the Journey package.
    </p>
</div>

<div class="packageBox">

    <h3>Smart Journey Package</h3>

    <p class="muted">
        Build a package from Journey stops and selected marketplace products.
    </p>

    <div class="packageItems" id="packageItems">

        <div class="empty">
            Select an accommodation first.
        </div>

    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;">

        <button class="primary" onclick="addPackageToCart()">
            Add Package To Cart
        </button>

        <button class="secondary" onclick="go('cart')">
            View Cart
        </button>

    </div>

</div>

</div>

</section>


<section class="section" id="cart">

<div class="container">

<div class="sectionTitle">
    <h2>Your Cart</h2>
    <p>Journey products selected for your travel package.</p>
</div>

<div class="cartLayout">

    <div class="cartItems" id="cartItems"></div>

    <div class="summary">

        <h3>Booking Summary</h3>

        <div class="summaryRow">
            <span>Items</span>
            <span id="summaryItems">0</span>
        </div>

        <div class="summaryRow">
            <span>Service Fee</span>
            <span id="summaryFee">IDR 0</span>
        </div>

        <div class="summaryTotal">
            <span>Total</span>
            <span id="summaryTotal">IDR 0</span>
        </div>

        <br>

        <button
            class="primary"
            style="width:100%;"
            onclick="go('booking')"
        >
            Continue Booking
        </button>

    </div>

</div>

</div>

</section>


<section class="section" id="booking">

<div class="container">

<div class="sectionTitle">
    <h2>Booking Demo</h2>
    <p>
        Investor demo booking flow. Real supplier booking will be connected later.
    </p>
</div>

<div class="bookingBox">

    <div class="bookingGrid">

        <input id="guestName" placeholder="Guest Name">

        <input id="guestEmail" placeholder="Email">

        <input id="guestPhone" placeholder="Phone">

        <select id="paymentMethod">
            <option>Credit Card</option>
            <option>Bank Transfer</option>
            <option>Company Billing</option>
        </select>

    </div>

    <div
        id="bookingSummary"
        class="currentJourney"
    >
        No items selected.
    </div>

    <button
        class="primary"
        style="width:100%;"
        onclick="confirmBooking()"
    >
        Confirm Demo Booking
    </button>

</div>

</div>

</section>


<footer>
    <div class="container">
        HobbiGo © 2026 • AI Journey & Experience Marketplace
        <br>
        V75.6 Real Location Accommodation Engine
    </div>
</footer>


<div class="toast" id="toast"></div>


