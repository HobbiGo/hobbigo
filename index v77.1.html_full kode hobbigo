  renderRoute();

  alert(
    "AI Smart Route optimized for the demo journey."
  );

}


/* -------------------------
   AI OPTIMIZATION
------------------------- */

function runOptimization(){

  const current =
    getTotal();

  if(current===0){

    document.getElementById("optimizationResult")
      .innerHTML =
      `<div class="alert alert-info">
        Select journey products first.
      </div>`;

    return;

  }

  let saving =
    Math.round(current*0.10);

  if(saving>2000000){
    saving=2000000;
  }

  const newTotal =
    current-saving;

  state.optimization = {

    current,

    saving,

    newTotal

  };

  document.getElementById("optimizationResult")
    .innerHTML = `

      <div class="alert alert-success">

        <strong>AI found a possible optimization.</strong>

        <br><br>

        Current:
        <strong>${rupiah(current)}</strong>

        <br>

        Potential Saving:
        <strong>${rupiah(saving)}</strong>

        <br>

        Estimated New Cost:
        <strong>${rupiah(newTotal)}</strong>

      </div>

    `;

  document
    .getElementById("applyOptimizationBtn")
    .classList.remove("hidden");

}


function applyOptimization(){

  if(!state.optimization){
    return;
  }

  const saving =
    state.optimization.saving;

  /*
    Demo optimization:
    Replace / reduce one selected product
    with a lower-priced alternative.
  */

  let changed=false;

  for(let i=0;i<state.selected.length;i++){

    const item =
      state.selected[i];

    if(item.category==="Hotel"){

      const alternative =
        products.find(p=>
          p.category==="Hotel" &&
          p.price < item.price
        );

      if(alternative){

        state.selected[i] = {

          ...alternative,

          qty:item.qty || 1

        };

        changed=true;

        break;

      }

    }

  }

  if(!changed && state.selected.length>0){

    state.selected.pop();

  }

  document.getElementById("optimizationResult")
    .innerHTML = `

      <div class="alert alert-success">

        ✓ AI Optimization Applied.

        <br>

        New estimated journey cost:
        <strong>${rupiah(getTotal())}</strong>

      </div>

    `;

  document
    .getElementById("applyOptimizationBtn")
    .classList.add("hidden");

  updateBudget();

  renderPackage();

}


