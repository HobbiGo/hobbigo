  const list =
    document.getElementById("routeList");

  if(!list) return;

  if(state.route.length===0){
    buildInitialRoute();
  }

  list.innerHTML =
    state.route.map((stop,index)=>`

      <li class="route-item">

        <div class="route-number">
          ${index+1}
        </div>

        <div>
          <strong>${stop}</strong>
        </div>

        <div class="route-controls">

          <button onclick="moveRoute(${index},-1)">
            ↑
          </button>

          <button onclick="moveRoute(${index},1)">
            ↓
          </button>

          <button onclick="removeRoute(${index})">
            ×
          </button>

        </div>

      </li>

    `).join("");

}


function moveRoute(index,direction){

  const newIndex =
    index+direction;

  if(newIndex<0 ||
     newIndex>=state.route.length){
    return;
  }

  const temp =
    state.route[index];

  state.route[index] =
    state.route[newIndex];

  state.route[newIndex] =
    temp;

  renderRoute();

}


function removeRoute(index){

  state.route.splice(index,1);

  renderRoute();

}


function addRouteStop(){

  const stop =
    prompt(
      "Enter a new journey stop:",
      "New Experience"
