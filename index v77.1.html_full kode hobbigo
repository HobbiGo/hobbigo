/* -------------------------
   INITIALIZATION
------------------------- */

function initialize(){

  const date =
    new Date();

  date.setDate(
    date.getDate()+14
  );

  const yyyy =
    date.getFullYear();

  const mm =
    String(date.getMonth()+1)
      .padStart(2,"0");

  const dd =
    String(date.getDate())
      .padStart(2,"0");

  document.getElementById("dateInput")
    .value =
      `${yyyy}-${mm}-${dd}`;

  selectCustomer("Personal");

  setMode("Hybrid");

  buildInitialRoute();

  renderProducts("All");

  updateBudget();

  updateCartBadge();

}

initialize();


/* close modal when clicking outside */

window.onclick=function(event){

  const modal =
    document.getElementById("productModal");

  if(event.target===modal){

    closeModal();

  }

};

