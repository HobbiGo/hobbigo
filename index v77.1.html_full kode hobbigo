------------------------- */

function setMode(mode){

  state.mode = mode;

  document.querySelectorAll(".mode-card")
    .forEach(card => card.classList.remove("selected"));

  if(mode==="AI"){
    document.getElementById("mode-ai").classList.add("selected");
  }

  if(mode==="Manual"){
    document.getElementById("mode-manual").classList.add("selected");
  }

  if(mode==="Hybrid"){
    document.getElementById("mode-hybrid").classList.add("selected");
  }

}


/* -------------------------
   GENERATE TRIP
------------------------- */

function generateTrip(){

  state.destination =
    document.getElementById("destinationInput").value;

  state.travelers =
    Number(document.getElementById("travellerInput").value) || 1;

  state.duration =
    Number(document.getElementById("durationInput").value) || 1;

  state.budget =
    Number(document.getElementById("budgetInput").value) || 0;

  state.style =
    document.getElementById("styleInput").value;

  state.interest =
    document.getElementById("interestInput").value;

  if(state.mode==="AI" || state.mode==="Hybrid"){

    aiRecommend();

  }else{

    state.selected = [];

  }

  updateBudget();

  showPage("pick");

}


/* -------------------------
   AI RECOMMENDATION
------------------------- */

function aiRecommend(){

  state.selected = [];

  const hotel =
    state.style==="Premium" || state.style==="Exclusive"
    ? products.find(p=>p.id==="hotel-bali-1")
    : products.find(p=>p.id==="hotel-bali-2");

  const flight =
    state.style==="Premium" || state.style==="Exclusive"
    ? products.find(p=>p.id==="flight-bali-2")
    : products.find(p=>p.id==="flight-bali-1");

  const transport =
    products.find(p=>p.id==="transport-1");

  let activity;

  if(state.interest==="Adventure"){
    activity =
      products.find(p=>p.id==="activity-1");
  }else{
    activity =
      products.find(p=>p.id==="activity-2");
  }

  const attraction =
    products.find(p=>p.id==="attraction-2");

  const restaurant =
    products.find(p=>p.id==="restaurant-1");

  const boat =
    products.find(p=>p.id==="boat-2");

  const choices =
    [hotel,flight,transport,activity,attraction,restaurant,boat];

  choices.forEach(item=>{
    if(item){
      state.selected.push({
        ...item,
        qty: item.unit==="person"
          ? state.travelers
          : 1
      });
    }
  });

  document.getElementById("aiMessage").innerHTML =
    "<strong>AI Recommendation:</strong> " +
    "I selected a starting journey based on your destination, " +
    "style, interest and budget. You can change every item manually.";

}


/* -------------------------
   PRODUCT RENDER
------------------------- */

function filterProducts(category,button){

  document.querySelectorAll(".category-tabs button")
    .forEach(b=>b.classList.remove("active"));

  if(button){
    button.classList.add("active");
  }

  renderProducts(category);

}


function renderProducts(category){

  const grid =
    document.getElementById("productGrid");

  if(!grid) return;

  const list =
    category==="All"
    ? products
    : products.filter(p=>p.category===category);

  grid.innerHTML =
    list.map(productCard).join("");

}


function productCard(p){

  const selected =
    state.selected.some(item=>item.id===p.id);

  return `

  <div class="card product-card ${selected ? "selected":""}">

    <div class="product-top">

      <div class="card-icon">${p.icon}</div>

      <span class="tag">${p.category}</span>

    </div>

    <h3>${p.name}</h3>

    <p>${p.location}</p>

    <p class="small">⭐ ${p.rating} · ${p.unit}</p>

    <p style="margin-top:8px">${p.description}</p>

    <div class="price">${rupiah(p.price)}</div>

    <div class="btn-row">

      <button class="${selected ? "danger":"primary"}"
        onclick="toggleProduct('${p.id}')">

        ${selected ? "Remove":"Add To Journey"}

      </button>

      <button class="secondary"
        onclick="showProduct('${p.id}')">

        Details

      </button>

    </div>

  </div>

  `;

}


/* -------------------------
   TOGGLE PRODUCT
------------------------- */

function toggleProduct(id){

  const product =
    products.find(p=>p.id===id);

  if(!product) return;

  const index =
    state.selected.findIndex(p=>p.id===id);

  if(index>=0){

    state.selected.splice(index,1);

  }else{

    state.selected.push({
      ...product,
      qty: product.unit==="person"
        ? state.travelers
        : 1
    });

  }

  renderProducts("All");
  updateBudget();

}


/* -------------------------
   TOTAL
------------------------- */

function getTotal(){

  return state.selected.reduce(
    (sum,item)=>{

      const qty =
        item.qty || 1;

      return sum + (item.price * qty);

    },0
  );

}


function calculateTotal(){

  state.travelers =
    Number(document.getElementById("travellerInput").value) || 1;

  state.budget =
    Number(document.getElementById("budgetInput").value) || 0;

  state.selected =
    state.selected.map(item=>({

      ...item,

      qty:item.unit==="person"
        ? state.travelers
        : item.qty || 1

    }));

  updateBudget();

}


function updateBudget(){

  const total = getTotal();

  const budget = state.budget;

  const remaining =
    budget-total;

  const display =
    document.getElementById("budgetDisplay");

  if(display){
    display.innerText = rupiah(budget);
  }

  const used =
    document.getElementById("budgetUsed");

  if(used){
    used.innerText = rupiah(total);
  }

  const rem =
    document.getElementById("budgetRemaining");

  if(rem){

    rem.innerText =
      rupiah(Math.max(remaining,0));

    rem.className =
      remaining>=0 ? "good":"over";

  }

}


/* -------------------------
   PACKAGE
------------------------- */

function renderPackage(){

  const container =
    document.getElementById("packageItems");

  if(!container) return;

  if(state.selected.length===0){

    container.innerHTML =
      `<p class="muted">
        No items selected yet.
      </p>`;

  }else{

    container.innerHTML =
      state.selected.map(item=>`

        <div class="breakdown-row">

          <div>
            <strong>${item.icon} ${item.name}</strong>
            <div class="small muted">
              ${item.category} · Qty ${item.qty || 1}
            </div>
          </div>

          <div>
            ${rupiah(item.price*(item.qty||1))}
          </div>

        </div>

      `).join("");

  }

  renderCostBreakdown();

}


function renderCostBreakdown(){

  const container =
    document.getElementById("costBreakdown");

  const total =
    getTotal();

  const travelers =
    state.travelers || 1;

  let serviceFee =
    Math.round(total*0.035);

  if(serviceFee<50000 && total>0){
    serviceFee=50000;
  }

  const grand =
    total+serviceFee;

  container.innerHTML = `

    <div class="breakdown-row">
      <span>Marketplace Products</span>
      <strong>${rupiah(total)}</strong>
    </div>

    <div class="breakdown-row">
      <span>HobbiGo Service / Platform</span>
      <strong>${rupiah(serviceFee)}</strong>
    </div>

    <div class="breakdown-row">
      <span>Estimated Customer Cost</span>
      <strong>${rupiah(grand)}</strong>
    </div>

  `;

  document.getElementById("grandTotal")
    .innerText = rupiah(grand);

  document.getElementById("perPerson")
    .innerText =
      rupiah(grand/travelers) +
      " / person";

  const budgetStatus =
    document.getElementById("budgetStatus");

  const difference =
    state.budget-grand;

  if(difference>=0){

    budgetStatus.innerHTML =
      `<div class="alert alert-success">
        ✓ Within budget.
        Remaining ${rupiah(difference)}
      </div>`;

  }else{

    budgetStatus.innerHTML =
      `<div class="alert alert-warning">
        ⚠ Over budget by ${rupiah(Math.abs(difference))}
      </div>`;

  }

}


