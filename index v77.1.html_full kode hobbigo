------------------------- */

function selectCustomer(type){

  state.customerType = type;

  document.querySelectorAll(".customer-card")
    .forEach(card => card.classList.remove("selected"));

  const id =
    "customer-" +
    type.toLowerCase();

  const element =
    document.getElementById(id);

  if(element){
    element.classList.add("selected");
  }

}


