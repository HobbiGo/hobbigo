<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HobbiGo V77.1 - Unified Investor Demo</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f7fb;
  color:#18212f;
  line-height:1.5;
}

button,input,select{font:inherit}

button{
  cursor:pointer;
  border:none;
}

.header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#101828;
  color:white;
  padding:14px 20px;
  box-shadow:0 3px 12px rgba(0,0,0,.15);
}

.header-inner{
  max-width:1250px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo{
  font-size:25px;
  font-weight:800;
  color:#fff;
}

.logo span{
  color:#22c55e;
}

.nav{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}

.nav button{
  background:transparent;
  color:#dbe4ef;
  padding:8px 10px;
  border-radius:8px;
  font-size:13px;
}

.nav button:hover{
  background:#1d2939;
}

.cart-badge{
  background:#22c55e;
  color:#07130a;
  padding:2px 7px;
  border-radius:20px;
  font-size:11px;
  font-weight:bold;
}

.hero{
  background:linear-gradient(135deg,#0f172a,#164e63,#047857);
  color:white;
  padding:65px 20px;
}

.hero-inner{
  max-width:1250px;
  margin:auto;
}

.hero h1{
  font-size:48px;
  line-height:1.1;
  max-width:800px;
  margin-bottom:18px;
}

.hero p{
  max-width:750px;
  color:#d9f7e5;
  font-size:18px;
  margin-bottom:25px;
}

.hero-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.container{
  max-width:1250px;
  margin:auto;
  padding:30px 18px;
}

.section{
  display:none;
}

.section.active{
  display:block;
}

.section-title{
  margin-bottom:20px;
}

.section-title h2{
  font-size:30px;
  margin-bottom:5px;
}

.section-title p{
  color:#667085;
}

.panel{
  background:white;
  border-radius:16px;
  padding:22px;
  margin-bottom:20px;
  box-shadow:0 5px 20px rgba(16,24,40,.07);
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.grid-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.grid-2{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:16px;
}

.card{
  background:white;
  border:1px solid #e4e7ec;
  border-radius:15px;
  padding:18px;
  transition:.2s;
}

.card:hover{
  transform:translateY(-2px);
  box-shadow:0 7px 20px rgba(16,24,40,.09);
}

.card.selected{
  border:2px solid #16a34a;
  background:#f0fdf4;
}

.card-icon{
  font-size:36px;
  margin-bottom:8px;
}

.card h3{
  margin-bottom:6px;
}

.card p{
  color:#667085;
  font-size:14px;
}

.price{
  font-size:20px;
  font-weight:800;
  margin:12px 0;
}

.muted{
  color:#667085;
}

.small{
  font-size:12px;
}

.primary{
  background:#16a34a;
  color:white;
  padding:11px 17px;
  border-radius:9px;
  font-weight:700;
}

.primary:hover{
  background:#15803d;
}

.secondary{
  background:#eaf0f6;
  color:#18212f;
  padding:11px 17px;
  border-radius:9px;
  font-weight:700;
}

.dark{
  background:#101828;
  color:white;
  padding:11px 17px;
  border-radius:9px;
  font-weight:700;
}

.warning{
  background:#f59e0b;
  color:white;
  padding:11px 17px;
  border-radius:9px;
  font-weight:700;
}

.danger{
  background:#dc2626;
  color:white;
  padding:8px 12px;
  border-radius:8px;
}

.btn-row{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:14px;
}

.form-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:bold;
  margin-bottom:6px;
}

.field input,
.field select{
  width:100%;
  padding:11px;
  border:1px solid #d0d5dd;
  border-radius:9px;
  background:white;
}

.customer-card{
  text-align:center;
  padding:25px 15px;
}

.customer-card .card-icon{
  font-size:42px;
}

.customer-card button{
  margin-top:12px;
  width:100%;
}

.destination{
  min-height:190px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  color:white;
  padding:20px;
  border-radius:16px;
  overflow:hidden;
  position:relative;
  background:linear-gradient(145deg,#134e4a,#0891b2);
}

.destination:nth-child(2){
  background:linear-gradient(145deg,#312e81,#7c3aed);
}

.destination:nth-child(3){
  background:linear-gradient(145deg,#7c2d12,#ea580c);
}

.destination:nth-child(4){
  background:linear-gradient(145deg,#164e63,#0891b2);
}

.destination:nth-child(5){
  background:linear-gradient(145deg,#3f6212,#65a30d);
}

.destination h3{
  font-size:25px;
}

.destination p{
  color:#ecfeff;
}

.mode-card{
  text-align:center;
  border:2px solid #e4e7ec;
  padding:25px;
}

.mode-card.selected{
  border-color:#16a34a;
  background:#f0fdf4;
}

.mode-card button{
  margin-top:14px;
}

.category-tabs{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-bottom:20px;
}

.category-tabs button{
  background:#eef2f6;
  padding:9px 13px;
  border-radius:20px;
}

.category-tabs button.active{
  background:#101828;
  color:white;
}

.product-card{
  display:flex;
  flex-direction:column;
}

.product-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.tag{
  display:inline-block;
  padding:4px 8px;
  border-radius:20px;
  background:#ecfdf3;
  color:#15803d;
  font-size:11px;
  font-weight:bold;
}

.ai-box{
  border:2px solid #7c3aed;
  background:#faf5ff;
  border-radius:16px;
  padding:20px;
}

.ai-title{
  color:#6d28d9;
  font-weight:800;
  font-size:18px;
}

.budget-box{
  background:#101828;
  color:white;
  border-radius:16px;
  padding:20px;
}

.budget-number{
  font-size:30px;
  font-weight:800;
}

.good{
  color:#22c55e;
  font-weight:bold;
}

.over{
  color:#f87171;
  font-weight:bold;
}

.breakdown-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:11px 0;
  border-bottom:1px solid #eaecf0;
}

.breakdown-row:last-child{
  border-bottom:none;
}

.total-box{
  background:#ecfdf3;
  border:2px solid #16a34a;
  border-radius:16px;
  padding:22px;
  margin-top:18px;
}

.total-price{
  font-size:36px;
  font-weight:900;
  color:#15803d;
}

.route-list{
  list-style:none;
}

.route-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px;
  border:1px solid #e4e7ec;
  border-radius:10px;
  margin-bottom:8px;
  background:white;
}

.route-number{
  width:30px;
  height:30px;
  border-radius:50%;
  background:#101828;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
}

.route-controls{
  margin-left:auto;
  display:flex;
  gap:5px;
}

.route-controls button{
  padding:5px 8px;
  border-radius:6px;
  background:#eef2f6;
}

.cart-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid #eaecf0;
}

.cart-left{
  display:flex;
  gap:12px;
  align-items:center;
}

.cart-icon{
  font-size:28px;
}

.payment-option{
  border:1px solid #d0d5dd;
  border-radius:10px;
  padding:15px;
  margin-bottom:10px;
}

.payment-option.selected{
  border:2px solid #16a34a;
  background:#f0fdf4;
}

.voucher{
  border:2px dashed #16a34a;
  padding:25px;
  border-radius:16px;
  background:#f0fdf4;
}

.video-screen{
  background:#101828;
  color:white;
  min-height:360px;
  border-radius:18px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:30px;
}

.video-screen .big{
  font-size:65px;
}

.share-box{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.stat-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.stat{
  background:white;
  padding:18px;
  border-radius:12px;
  border:1px solid #e4e7ec;
}

.stat strong{
  display:block;
  font-size:23px;
}

.alert{
  padding:14px;
  border-radius:10px;
  margin:12px 0;
}

.alert-info{
  background:#eff8ff;
  color:#175cd3;
}

.alert-success{
  background:#ecfdf3;
  color:#027a48;
}

.alert-warning{
  background:#fffaeb;
  color:#b54708;
}

.footer{
  background:#101828;
  color:#cbd5e1;
  text-align:center;
  padding:35px 20px;
  margin-top:40px;
}

.modal{
  display:none;
  position:fixed;
  z-index:3000;
  left:0;
  top:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,.65);
  padding:20px;
}

.modal-content{
  max-width:600px;
  margin:8% auto;
  background:white;
  border-radius:16px;
  padding:25px;
}

.close{
  float:right;
  font-size:25px;
  cursor:pointer;
}

.hidden{
  display:none!important;
}

@media(max-width:900px){
  .grid,.grid-3,.grid-2,.form-grid,.stat-grid{
    grid-template-columns:repeat(2,1fr);
  }
  .hero h1{font-size:38px}
}

@media(max-width:600px){
  .grid,.grid-3,.grid-2,.form-grid,.stat-grid{
    grid-template-columns:1fr;
  }
  .nav{display:none}
  .hero h1{font-size:32px}
  .header-inner{justify-content:center}
}
</style>
</head>

<body>

<header class="header">
  <div class="header-inner">
    <div class="logo">Hobbi<span>Go</span></div>

    <nav class="nav">
      <button onclick="showPage('home')">Home</button>
      <button onclick="showPage('planner')">Plan</button>
      <button onclick="showPage('pick')">Pick</button>
      <button onclick="showPage('route')">Route</button>
      <button onclick="showPage('package')">Package</button>
      <button onclick="showPage('cart')">
        Cart <span class="cart-badge" id="cartBadge">0</span>
      </button>
      <button onclick="showPage('mytrip')">My Trip</button>
    </nav>
  </div>
</header>

<!-- HOME -->
<section id="home" class="section active">

  <div class="hero">
    <div class="hero-inner">
      <div class="tag">AI JOURNEY & EXPERIENCE MARKETPLACE</div>

      <h1>Plan, Configure, Book & Experience Your Journey With HobbiGo.</h1>

      <p>
        AI membantu customer menemukan perjalanan terbaik berdasarkan
        destination, budget, interest dan kebutuhan mereka.
        Customer tetap bebas memilih sendiri setiap bagian perjalanan.
      </p>

      <div class="hero-buttons">
        <button class="primary" onclick="startDemo()">Start Journey</button>
        <button class="secondary" onclick="showPage('planner')">
          Build My Trip
        </button>
      </div>
    </div>
  </div>

  <div class="container">

    <div class="stat-grid">
      <div class="stat">
        <span class="muted">Planning</span>
        <strong>AI + Manual</strong>
      </div>

      <div class="stat">
        <span class="muted">Marketplace</span>
        <strong>Multi Category</strong>
      </div>

      <div class="stat">
        <span class="muted">Optimization</span>
        <strong>Smart Route</strong>
      </div>

      <div class="stat">
        <span class="muted">Transaction</span>
        <strong>End-to-End</strong>
      </div>
    </div>

    <div class="panel">
      <div class="section-title">
        <h2>How HobbiGo Works</h2>
        <p>Investor demo flow from planning to journey sharing.</p>
      </div>

      <div class="grid">
        <div class="card">
          <div class="card-icon">🤖</div>
          <h3>AI Planning</h3>
          <p>AI recommends trip based on budget and interests.</p>
        </div>

        <div class="card">
          <div class="card-icon">✋</div>
          <h3>Manual Pick</h3>
          <p>Customer can select individual products.</p>
        </div>

        <div class="card">
          <div class="card-icon">💰</div>
          <h3>Budget Control</h3>
          <p>Every selection changes total expenditure.</p>
        </div>

        <div class="card">
          <div class="card-icon">🎥</div>
          <h3>Journey Story</h3>
          <p>Turn the trip into a shareable journey story.</p>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- PLANNER -->
<section id="planner" class="section">

<div class="container">

  <div class="section-title">
    <h2>HobbiGo Trip Planner</h2>
    <p>Start with customer type, destination and budget.</p>
  </div>

  <div class="panel">

    <h3>1. Who is travelling?</h3>

    <div class="grid">

      <div class="card customer-card" id="customer-personal">
        <div class="card-icon">👤</div>
        <h3>Personal</h3>
        <p>Individual journey</p>
        <button class="secondary" onclick="selectCustomer('Personal')">
          Select
        </button>
      </div>

      <div class="card customer-card" id="customer-family">
        <div class="card-icon">👨‍👩‍👧‍👦</div>
        <h3>Family</h3>
        <p>Family journey</p>
        <button class="secondary" onclick="selectCustomer('Family')">
          Select
        </button>
      </div>

      <div class="card customer-card" id="customer-group">
        <div class="card-icon">👥</div>
        <h3>Group</h3>
        <p>Friends / community</p>
        <button class="secondary" onclick="selectCustomer('Group')">
          Select
        </button>
      </div>

      <div class="card customer-card" id="customer-corporate">
        <div class="card-icon">🏢</div>
        <h3>Corporate</h3>
        <p>Meeting / retreat / event</p>
        <button class="secondary" onclick="selectCustomer('Corporate')">
          Select
        </button>
      </div>

    </div>

  </div>


  <div class="panel">

    <h3>2. Trip Configuration</h3>

    <div class="form-grid">

      <div class="field">
        <label>Destination</label>

        <select id="destinationInput" onchange="setDestination(this.value)">
          <option value="Bali">Bali</option>
          <option value="Jakarta">Jakarta</option>
          <option value="Singapore">Singapore</option>
          <option value="Bangkok">Bangkok</option>
          <option value="Tokyo">Tokyo</option>
        </select>
      </div>

      <div class="field">
        <label>Start Date</label>
        <input type="date" id="dateInput">
      </div>

      <div class="field">
        <label>Travellers</label>
        <input type="number" id="travellerInput" value="2" min="1"
               onchange="calculateTotal()">
      </div>

      <div class="field">
        <label>Duration (days)</label>
        <input type="number" id="durationInput" value="4" min="1">
      </div>

      <div class="field">
        <label>Budget (Rp)</label>
        <input type="number" id="budgetInput"
               value="15000000"
               onchange="calculateTotal()">
      </div>

      <div class="field">
        <label>Trip Style</label>

        <select id="styleInput">
          <option>Best Value</option>
          <option>Economy</option>
          <option>Comfort</option>
          <option>Premium</option>
          <option>Exclusive</option>
        </select>
      </div>

      <div class="field">
        <label>Main Interest</label>

        <select id="interestInput">
          <option>Nature</option>
          <option>Culinary</option>
          <option>Adventure</option>
          <option>Culture</option>
          <option>Relaxation</option>
          <option>Shopping</option>
        </select>
      </div>

    </div>

  </div>


  <div class="panel">

    <h3>3. Choose Your Planning Mode</h3>

    <div class="grid-3">

      <div class="card mode-card" id="mode-ai">
        <div class="card-icon">🤖</div>
        <h3>AI PLAN</h3>
        <p>Let HobbiGo recommend your complete journey.</p>

        <button class="primary" onclick="setMode('AI')">
          Use AI
        </button>
      </div>

      <div class="card mode-card" id="mode-manual">
        <div class="card-icon">✋</div>
        <h3>MANUAL PICK</h3>
        <p>Choose hotels, activities, food and transport yourself.</p>

        <button class="secondary" onclick="setMode('Manual')">
          Pick Myself
        </button>
      </div>

      <div class="card mode-card" id="mode-hybrid">
        <div class="card-icon">🤖 + ✋</div>
        <h3>AI + MANUAL</h3>
        <p>AI recommends. Customer decides.</p>

        <button class="dark" onclick="setMode('Hybrid')">
          Best of Both
        </button>
      </div>

    </div>

    <div class="btn-row">
      <button class="primary" onclick="generateTrip()">
        Generate / Continue Trip
      </button>
    </div>

  </div>


  <div id="aiPlanResult" class="panel hidden"></div>

</div>
</section>


<!-- PICK -->
<section id="pick" class="section">

<div class="container">

  <div class="section-title">
    <h2>Pick Your Journey</h2>
    <p>Select individual products or replace AI recommendations.</p>
  </div>

  <div class="ai-box">

    <div class="ai-title">🤖 HobbiGo AI Assistant</div>

    <p id="aiMessage" style="margin-top:8px">
      Choose products manually or let AI recommend products within your budget.
    </p>

  </div>

  <br>

  <div class="panel">

    <div class="budget-box">

      <div class="small">YOUR BUDGET</div>

      <div class="budget-number" id="budgetDisplay">
        Rp 15.000.000
      </div>

      <div style="margin-top:8px">
        Current spending:
        <strong id="budgetUsed">Rp 0</strong>
      </div>

      <div>
        Remaining:
        <strong id="budgetRemaining">Rp 15.000.000</strong>
      </div>

    </div>

  </div>


  <div class="panel">

    <div class="category-tabs">

      <button class="active" onclick="filterProducts('All',this)">All</button>
      <button onclick="filterProducts('Hotel',this)">Hotel</button>
      <button onclick="filterProducts('Villa',this)">Villa</button>
      <button onclick="filterProducts('Flight',this)">Flight</button>
      <button onclick="filterProducts('Transport',this)">Transport</button>
      <button onclick="filterProducts('Attraction',this)">Attraction</button>
      <button onclick="filterProducts('Activity',this)">Activity</button>
      <button onclick="filterProducts('Restaurant',this)">Restaurant</button>
      <button onclick="filterProducts('Boat',this)">Boat</button>
      <button onclick="filterProducts('Ticket',this)">Ticket</button>

    </div>

    <div id="productGrid" class="grid"></div>

  </div>

</div>
</section>


<!-- ROUTE -->
<section id="route" class="section">

<div class="container">

  <div class="section-title">
    <h2>Smart Route</h2>
    <p>Configure the order of your journey.</p>
  </div>

  <div class="panel">

    <div class="ai-box">

      <div class="ai-title">🧠 AI Smart Route</div>

      <p>
        HobbiGo analyzes the selected places and creates a practical
        journey order. You can still manually rearrange it.
      </p>

    </div>

    <br>

    <ul class="route-list" id="routeList"></ul>

    <div class="btn-row">
      <button class="primary" onclick="optimizeRoute()">
        🤖 Optimize Route
      </button>

      <button class="secondary" onclick="addRouteStop()">
        + Add Stop
      </button>
    </div>

  </div>

</div>
</section>


<!-- PACKAGE -->
<section id="package" class="section">

<div class="container">

  <div class="section-title">
    <h2>Package Builder & Total Cost</h2>
    <p>Every customer choice is converted into a transparent trip cost.</p>
  </div>

  <div class="grid-2">

    <div class="panel">

      <h3>Selected Journey</h3>

      <div id="packageItems"></div>

    </div>

    <div class="panel">

      <h3>Trip Financial Summary</h3>

      <div id="costBreakdown"></div>

      <div class="total-box">

        <div class="muted">TOTAL CUSTOMER EXPENDITURE</div>

        <div class="total-price" id="grandTotal">
          Rp 0
        </div>

        <div id="perPerson" style="margin-top:8px">
          Rp 0 / person
        </div>

      </div>

      <div id="budgetStatus"></div>

    </div>

  </div>


  <div class="panel">

    <div class="ai-box">

      <div class="ai-title">🤖 AI Budget Optimization</div>

      <p>
        HobbiGo can look for a more efficient combination while keeping
        the customer's journey requirements.
      </p>

      <div id="optimizationResult"></div>

      <div class="btn-row">
        <button class="warning" onclick="runOptimization()">
          Find Better Price
        </button>

        <button class="primary hidden" id="applyOptimizationBtn"
                onclick="applyOptimization()">
          Apply AI Optimization
