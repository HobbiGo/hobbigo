function chooseRoute(name){

  showToast(`${name} route selected ✓`);

  const destination =
    document.getElementById("aiDestination").value || "Bali";

  const packageProduct =
    products.find(p=>
      p.type==="package" &&
      p.city.toLowerCase()===destination.toLowerCase()
    );

  if(packageProduct){

    setTimeout(()=>{
      openBooking(packageProduct.id);
    },500);

  }else{

    setTimeout(()=>{
      filterType("package");
    },500);

  }

}

