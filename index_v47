}

function renderCart(){

  const box = document.getElementById("cartItems");

  if(!cart.length){

    box.innerHTML = `
      <div class="empty">
        <div style="font-size:45px">🛒</div>
        <h3>Your cart is empty</h3>
        <p>Add hotel, flight, attraction, activity or other experiences.</p>
      </div>
    `;

    document.getElementById("cartSubtotal").textContent = money(0);
    document.getElementById("cartFee").textContent = money(0);
    document.getElementById("cartTax").textContent = money(0);
    document.getElementById("cartTotal").textContent = money(0);

    return;

  }

  box.innerHTML = cart.map((item,index)=>`

    <div class="cartItem">

      <img src="${esc(item.image)}">

      <div>

        <h4>${esc(item.name)}</h4>

        <p>
          ${esc(item.category)} ·
          ${esc(item.city)}, ${esc(item.country)}
        </p>

        <p>
          ${item.date || "Flexible date"} ·
          ${item.people} person(s)
        </p>

        <strong>${money(item.unitPrice)}</strong>

      </div>

      <button class="secondary"
        onclick="removeCart(${index})">
        Remove
      </button>

    </div>

  `).join("");

  const subtotal = cart.reduce(
    (sum,item)=>sum + item.unitPrice * item.qty,
    0
  );

  const fee = Math.round(subtotal * .03);

  const tax = Math.round(subtotal * .11);

  const total = subtotal + fee + tax;

  document.getElementById("cartSubtotal").textContent = money(subtotal);
  document.getElementById("cartFee").textContent = money(fee);
  document.getElementById("cartTax").textContent = money(tax);
  document.getElementById("cartTotal").textContent = money(total);

}

function removeCart(index){

  cart.splice(index,1);

  saveCart();

  updateCartBadge();

  renderCart();

  showToast("Removed from cart");

}

function checkout(){

  if(!cart.length){

    showToast("Your cart is empty");

    return;

  }

  const subtotal = cart.reduce(
    (sum,item)=>sum + item.unitPrice * item.qty,
    0
  );

  const fee = Math.round(subtotal*.03);
  const tax = Math.round(subtotal*.11);
  const total = subtotal+fee+tax;

  document.getElementById("paymentTotal").textContent =
    money(total);

  closeModal("cartModal");

  openModal("paymentModal");

}

function confirmPayment(){

  if(!cart.length)return;

  const name =
    document.getElementById("customerName").value ||
    "HobbiGo Customer";

  const email =
    document.getElementById("customerEmail").value ||
    "customer@hobbigo.demo";

  const method =
    document.getElementById("paymentMethod").value;

  const subtotal = cart.reduce(
    (sum,item)=>sum+item.unitPrice*item.qty,
    0
  );

  const fee = Math.round(subtotal*.03);
  const tax = Math.round(subtotal*.11);
  const total = subtotal+fee+tax;

  const order = {

    orderId:makeId("HG"),

    createdAt:new Date().toISOString(),

    customer:{
      name,
      email
    },

    payment:method,

    subtotal,
    fee,
    tax,
    total,

    status:"CONFIRMED",

    paymentStatus:"PAID - DEMO",

    items:[...cart]

  };

  orders.unshift(order);

  saveOrders();

  const ticket =
    "HBG-" +
    Math.random().toString(36)
      .substring(2,8)
      .toUpperCase();

  document.getElementById("ticketContent").innerHTML = `

    <strong>HobbiGo Travel</strong>

    <div style="margin-top:12px">
      Order ID
    </div>

    <div class="ticketCode">
      ${esc(order.orderId)}
    </div>

    <div style="margin-top:15px">
      Voucher / E-ticket
    </div>

    <div class="ticketCode">
      ${ticket}
    </div>

    <hr style="border:0;border-top:1px solid #dbe5f0">

    <div>
      <strong>${esc(name)}</strong><br>
      ${esc(email)}<br>
      Payment: ${esc(method)}<br>
      Total: <strong>${money(total)}</strong>
    </div>

    <div style="margin-top:15px;color:#0a8754">
      ✓ BOOKING CONFIRMED
    </div>

  `;

  cart = [];

  saveCart();

  updateCartBadge();

  closeModal("paymentModal");

  openModal("successModal");

}

