<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HobbiGo Travel — AI Journey & Experience Marketplace</title>

<style>
:root{
  --navy:#062b63;
  --blue:#0877e8;
  --cyan:#13b8e8;
  --orange:#ff8a00;
  --orange2:#ffb000;
  --green:#16a66a;
  --red:#ef4444;
  --bg:#f4f8fc;
  --card:#fff;
  --text:#132238;
  --muted:#66758a;
  --border:#e4ebf3;
  --shadow:0 10px 35px rgba(6,43,99,.10);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:Inter,Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}

.topbar{
  background:#031c40;
  color:#fff;
  padding:8px 5%;
  display:flex;
  justify-content:space-between;
  font-size:12px;
}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:#fff;
  border-bottom:1px solid var(--border);
  box-shadow:0 3px 15px rgba(0,0,0,.05);
}

.nav{
  max-width:1400px;
  margin:auto;
  height:74px;
  display:flex;
  align-items:center;
  gap:28px;
  padding:0 24px;
}

.logo{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:30px;
  font-weight:900;
  letter-spacing:-1.5px;
  color:var(--navy);
  white-space:nowrap;
}
.logo span{color:var(--orange)}
.logoDot{
  width:28px;
  height:28px;
  border-radius:50%;
  background:linear-gradient(135deg,#0877e8,#12bde9);
  position:relative;
  display:inline-block;
  box-shadow:inset 0 0 0 5px #fff;
}
.logoDot:after{
  content:"";
  position:absolute;
  width:8px;height:8px;
  background:var(--orange);
  border-radius:50%;
  left:10px;top:7px;
}

.navlinks{
  display:flex;
  gap:18px;
  flex:1;
}
.navlinks button{
  border:0;
  background:none;
  color:#3d4c61;
  font-weight:700;
}
.navlinks button:hover{color:var(--blue)}

.navActions{
  display:flex;
  gap:9px;
  align-items:center;
}

.iconBtn,.cartBtn{
  border:1px solid var(--border);
  background:#fff;
  padding:10px 13px;
  border-radius:12px;
  font-weight:800;
}
.cartBtn{position:relative}
.badge{
  position:absolute;
  right:-5px;
  top:-7px;
  background:var(--orange);
  color:#fff;
  width:20px;height:20px;
  border-radius:50%;
  font-size:11px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.hero{
  min-height:560px;
  background:
    linear-gradient(110deg,rgba(3,28,64,.96),rgba(6,66,128,.76)),
    url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=85")
    center/cover;
  color:#fff;
  padding:70px 5% 90px;
}

.heroInner{
  max-width:1400px;
  margin:auto;
}

.hero h1{
  font-size:58px;
  line-height:1.02;
  max-width:780px;
  margin:30px 0 18px;
  letter-spacing:-2px;
}
.hero h1 span{color:#ffb000}
.hero p{
  max-width:700px;
  font-size:18px;
  line-height:1.7;
  color:#e6f1ff;
}

.pill{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(255,255,255,.13);
  border:1px solid rgba(255,255,255,.25);
  border-radius:999px;
  padding:9px 15px;
  font-weight:700;
  font-size:13px;
}

.searchBox{
  margin-top:35px;
  max-width:1120px;
  background:#fff;
  border-radius:20px;
  padding:12px;
  display:grid;
  grid-template-columns:1.3fr 1fr .8fr .8fr 150px;
  gap:8px;
  box-shadow:0 18px 50px rgba(0,0,0,.25);
}

.searchItem{
  padding:12px 15px;
  border-right:1px solid #edf1f6;
}
.searchItem label{
  display:block;
  font-size:11px;
  color:#7a8797;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:4px;
}
.searchItem input,.searchItem select{
  border:0;
  outline:0;
  width:100%;
  color:#172337;
  font-weight:700;
  background:#fff;
}

.primary{
  background:linear-gradient(135deg,var(--orange),#ff5e00);
  color:#fff;
  border:0;
  border-radius:13px;
  font-weight:900;
  padding:13px 18px;
}
.primary:hover{filter:brightness(.97)}

.secondary{
  border:1px solid var(--border);
  background:#fff;
  color:var(--navy);
  border-radius:12px;
  padding:11px 15px;
  font-weight:800;
}

.aiStrip{
  max-width:1120px;
  margin:18px 0 0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.22);
  border-radius:18px;
  padding:15px 18px;
}
.aiStrip strong{color:#fff}

.section{
  max-width:1400px;
  margin:auto;
  padding:55px 24px;
}
.sectionHead{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin-bottom:25px;
}
.sectionHead h2{
  margin:0;
  font-size:30px;
  color:var(--navy);
}
.sectionHead p{
  margin:7px 0 0;
  color:var(--muted);
}

.categories{
  display:grid;
  grid-template-columns:repeat(8,1fr);
  gap:12px;
}
.cat{
  border:1px solid var(--border);
  background:#fff;
  border-radius:18px;
  padding:18px 10px;
  text-align:center;
  box-shadow:var(--shadow);
  transition:.2s;
}
.cat:hover{
  transform:translateY(-3px);
  border-color:#b9d8fa;
}
.catIcon{font-size:28px}
.cat small{
  display:block;
  margin-top:8px;
  font-weight:800;
}

.aiPlanner{
  background:linear-gradient(135deg,#062b63,#0877e8);
  color:#fff;
  border-radius:30px;
  padding:32px;
  box-shadow:var(--shadow);
}
.aiGrid{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:12px;
  margin-top:20px;
}
.field{
  background:#fff;
  border-radius:14px;
  padding:11px;
}
.field label{
  display:block;
  color:#75849a;
  font-size:11px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:4px;
}
.field input,.field select{
  border:0;
  outline:0;
  width:100%;
  color:#172337;
  font-weight:700;
}

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}
.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 8px 25px rgba(6,43,99,.07);
  transition:.2s;
}
.card:hover{
  transform:translateY(-4px);
  box-shadow:0 18px 40px rgba(6,43,99,.13);
}
.cardImg{
  height:205px;
  position:relative;
  overflow:hidden;
}
.cardImg img{
  width:100%;
  height:100%;
  object-fit:cover;
}
.typeBadge{
  position:absolute;
  top:12px;
  left:12px;
  background:#fff;
  color:var(--navy);
  border-radius:999px;
  padding:6px 10px;
  font-size:11px;
  font-weight:900;
}
.heart{
  position:absolute;
  right:12px;
  top:12px;
  width:34px;
  height:34px;
  border-radius:50%;
  border:0;
  background:#fff;
  font-size:17px;
}
.cardBody{padding:17px}
.cardBody h3{
  margin:0 0 7px;
  font-size:18px;
}
.location{
  color:#718095;
  font-size:13px;
}
.rating{
  margin-top:9px;
  font-size:13px;
  font-weight:800;
}
.price{
  margin-top:13px;
  font-size:19px;
  font-weight:900;
  color:var(--navy);
}
.price small{
  font-size:11px;
  color:#8390a1;
  font-weight:600;
}
.cardActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:15px;
}

.routeBox{
  background:#fff;
  border-radius:25px;
  padding:25px;
  box-shadow:var(--shadow);
}
.routeCards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}
.route{
  border:1px solid var(--border);
  border-radius:18px;
  padding:18px;
  position:relative;
}
.route.recommended{
  border:2px solid var(--green);
}
.recommendedTag{
  position:absolute;
  right:12px;
  top:12px;
  font-size:10px;
  background:#dcfce9;
  color:#087a4c;
  padding:5px 8px;
  border-radius:999px;
  font-weight:900;
}
.route h3{margin:0 0 8px}
.routePrice{
  font-size:23px;
  font-weight:900;
  color:var(--navy);
}
.route ul{
  padding-left:18px;
  color:#64748b;
  font-size:13px;
  line-height:1.8;
}

.itinerary{
  display:grid;
  gap:10px;
}
.day{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:17px;
  display:flex;
  gap:18px;
  align-items:center;
}
.dayNo{
  width:50px;
  height:50px;
  border-radius:14px;
  background:#eaf4ff;
  color:var(--blue);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
}
.day strong{display:block}
.day span{font-size:13px;color:var(--muted)}

.featureGrid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}
.feature{
  background:#fff;
  border-radius:20px;
  padding:24px;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
}
.feature .big{font-size:32px}
.feature h3{margin:12px 0 7px}
.feature p{font-size:13px;line-height:1.6;color:var(--muted)}

.promo{
  background:linear-gradient(135deg,#ff8a00,#ff4f00);
  color:#fff;
  border-radius:25px;
  padding:28px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.promo h2{margin:0 0 7px}

.footer{
  background:#031c40;
  color:#fff;
  padding:50px 5%;
}
.footerInner{
  max-width:1400px;
  margin:auto;
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:35px;
}
.footer p{color:#b9c8dc;line-height:1.7}
.footer h4{margin-top:0}
.footer div div{color:#b9c8dc;margin:9px 0;font-size:14px}

.modal{
  display:none;
  position:fixed;
  z-index:500;
  inset:0;
  background:rgba(2,18,38,.7);
  padding:25px;
  overflow:auto;
}
.modal.show{display:flex;align-items:center;justify-content:center}
.modalBox{
  background:#fff;
  width:min(850px,100%);
  max-height:92vh;
  overflow:auto;
  border-radius:25px;
  box-shadow:0 30px 100px rgba(0,0,0,.35);
}
.modalHead{
  padding:20px 24px;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.modalHead h2{margin:0;color:var(--navy)}
.close{
  border:0;
  background:#f1f5f9;
  width:36px;height:36px;
  border-radius:50%;
  font-size:20px;
}
.modalBody{padding:24px}

.detailImage{
  width:100%;
  height:280px;
  object-fit:cover;
  border-radius:18px;
}
.detailGrid{
  display:grid;
  grid-template-columns:1.4fr .8fr;
  gap:20px;
}
.detailPrice{
  background:#f5f9ff;
  padding:20px;
  border-radius:18px;
}
.detailPrice strong{
  display:block;
  font-size:28px;
  color:var(--navy);
}

.formGrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
}
.formGroup label{
  display:block;
  font-size:12px;
  color:#68788c;
  font-weight:800;
  margin-bottom:5px;
}
.formGroup input,.formGroup select,.formGroup textarea{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:11px;
  outline:none;
}
.formGroup textarea{min-height:80px}

.cartItem{
  display:grid;
  grid-template-columns:80px 1fr auto;
  gap:14px;
  align-items:center;
  border-bottom:1px solid var(--border);
  padding:13px 0;
}
.cartItem img{
  width:80px;height:60px;
  object-fit:cover;
  border-radius:10px;
}
.cartItem h4{margin:0 0 5px}
.cartItem p{margin:0;font-size:12px;color:var(--muted)}
.cartTotal{
  background:#f5f9ff;
  border-radius:16px;
  padding:18px;
  margin-top:18px;
}
.totalRow{
  display:flex;
  justify-content:space-between;
  padding:5px 0;
}
.totalRow.final{
  font-size:20px;
  font-weight:900;
  color:var(--navy);
  border-top:1px solid #dce6f2;
  margin-top:8px;
  padding-top:14px;
}

.success{
  text-align:center;
  padding:25px;
}
.successIcon{
  width:80px;height:80px;
  margin:10px auto 20px;
  border-radius:50%;
  background:#dcfce9;
  color:#0b8a55;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42px;
}
.ticket{
  background:#f8fbff;
  border:1px dashed #9fb8d5;
  border-radius:18px;
  padding:20px;
  margin-top:18px;
  text-align:left;
}
.ticketCode{
  font-size:25px;
  font-weight:900;
  letter-spacing:2px;
  color:var(--navy);
}

.mapDemo{
  height:330px;
  border-radius:22px;
  overflow:hidden;
  position:relative;
  background:
    linear-gradient(30deg,rgba(15,90,65,.13) 12%,transparent 12.5%,transparent 87%,rgba(15,90,65,.13) 87.5%),
    linear-gradient(150deg,rgba(15,90,65,.13) 12%,transparent 12.5%,transparent 87%,rgba(15,90,65,.13) 87.5%),
    #dbe9df;
  background-size:60px 60px;
}
.mapRoad{
  position:absolute;
  height:7px;
  background:#fff;
  box-shadow:0 0 0 1px #c7d5ca;
  transform:rotate(-20deg);
  width:120%;
  left:-10%;
}
.mapRoad.r2{top:50%;transform:rotate(18deg)}
.mapRoad.r3{top:20%;transform:rotate(5deg)}
.mapPin{
  position:absolute;
  width:42px;height:42px;
  border-radius:50% 50% 50% 0;
  background:var(--orange);
  transform:rotate(-45deg);
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-size:18px;
  box-shadow:0 5px 15px rgba(0,0,0,.2);
}
.mapPin:after{
  content:"";
  width:13px;height:13px;
  background:#fff;
  border-radius:50%;
}
.mapLabel{
  position:absolute;
  background:#fff;
  border-radius:12px;
  padding:9px 12px;
  box-shadow:var(--shadow);
  font-size:12px;
  font-weight:900;
}

.tripCard{
  background:#fff;
  border-radius:20px;
  padding:20px;
  border:1px solid var(--border);
  margin-bottom:12px;
}
.tripHeader{
  display:flex;
  justify-content:space-between;
  gap:15px;
}
.status{
  background:#dcfce9;
  color:#087a4c;
  border-radius:999px;
  padding:6px 10px;
  font-size:11px;
  font-weight:900;
  height:max-content;
}

.adminTable{
  width:100%;
  border-collapse:collapse;
}
.adminTable th,.adminTable td{
  border-bottom:1px solid var(--border);
  padding:10px;
  text-align:left;
  font-size:12px;
}
.adminTable th{background:#f6f9fd}

.empty{
  text-align:center;
  padding:35px;
  color:var(--muted);
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:1000;
  background:#062b63;
  color:#fff;
  border-radius:13px;
  padding:14px 18px;
  box-shadow:0 15px 40px rgba(0,0,0,.25);
  display:none;
}
.toast.show{display:block}

.hide{display:none!important}

@media(max-width:1100px){
  .products{grid-template-columns:repeat(3,1fr)}
  .categories{grid-template-columns:repeat(4,1fr)}
  .routeCards{grid-template-columns:repeat(2,1fr)}
  .aiGrid{grid-template-columns:repeat(3,1fr)}
  .searchBox{grid-template-columns:1fr 1fr}
}

@media(max-width:800px){
  .nav{height:auto;padding:14px 15px;flex-wrap:wrap}
  .navlinks{order:3;width:100%;overflow:auto;padding-bottom:5px}
  .navlinks button{white-space:nowrap}
  .hero{padding:45px 18px 65px}
  .hero h1{font-size:39px}
  .searchBox{grid-template-columns:1fr}
  .searchItem{border-right:0;border-bottom:1px solid #edf1f6}
  .products{grid-template-columns:1fr 1fr}
  .featureGrid{grid-template-columns:1fr 1fr}
  .footerInner{grid-template-columns:1fr 1fr}
  .detailGrid{grid-template-columns:1fr}
}

@media(max-width:520px){
  .logo{font-size:24px}
  .topbar{display:none}
  .navActions .secondary{display:none}
  .categories{grid-template-columns:repeat(2,1fr)}
  .products{grid-template-columns:1fr}
  .routeCards,.featureGrid,.aiGrid,.formGrid{grid-template-columns:1fr}
  .section{padding:40px 15px}
  .hero h1{font-size:34px}
  .promo{display:block}
}
</style>
</head>

<body>

<div class="topbar">
  <span>🌍 HobbiGo Travel — AI Journey & Experience Marketplace</span>
  <span>English · Bahasa · 中文 · 日本語 · 한국어</span>
</div>

<header>
  <nav class="nav">
    <div class="logo" onclick="goHome()" style="cursor:pointer">
      Hobbi<span>Go</span><i class="logoDot"></i>
    </div>

    <div class="navlinks">
      <button onclick="goHome()">Explore</button>
      <button onclick="scrollToId('planner')">AI Plan</button>
      <button onclick="scrollToId('productsSection')">Book</button>
      <button onclick="scrollToId('routeSection')">Smart Route</button>
      <button onclick="showTrips()">My Trips</button>
      <button onclick="openAdmin()">Admin</button>
    </div>

    <div class="navActions">
      <button class="iconBtn" onclick="showToast('Language selector ready')">🌐</button>
      <button class="cartBtn" onclick="openCart()">
        🛒 My Cart
        <span class="badge" id="cartCount">0</span>
      </button>
    </div>
  </nav>
</header>

<section class="hero" id="home">
  <div class="heroInner">

    <span class="pill">🤖 AI Journey & Experience Marketplace</span>

    <h1>
      Your World.<br>
      <span>One Journey.</span>
    </h1>

    <p>
      Search, plan, configure, package and book your complete journey
      with HobbiGo — from hotels and flights to culinary, attractions,
      activities, transport and unique experiences.
    </p>

    <div class="searchBox">
      <div class="searchItem">
        <label>Destination</label>
        <input id="searchDestination" placeholder="Bali, Tokyo, Paris..." oninput="searchProducts()">
      </div>

      <div class="searchItem">
        <label>Country</label>
        <select id="searchCountry" onchange="searchProducts()">
          <option value="">All Countries</option>
          <option>Indonesia</option>
          <option>Singapore</option>
          <option>Japan</option>
          <option>China</option>
          <option>Thailand</option>
          <option>France</option>
          <option>United Arab Emirates</option>
        </select>
      </div>

      <div class="searchItem">
        <label>Check-in</label>
        <input type="date" id="searchDate">
      </div>

      <div class="searchItem">
        <label>Travelers</label>
        <select id="searchPeople">
          <option>1 Traveler</option>
          <option>2 Travelers</option>
          <option>3 Travelers</option>
          <option>4 Travelers</option>
          <option>5+ Travelers</option>
        </select>
      </div>

      <button class="primary" onclick="runSearch()">Search</button>
    </div>

    <div class="aiStrip">
      <div>
        <strong>✨ Let AI build your journey</strong><br>
        <span style="font-size:12px;color:#dceaff">
          Destination → itinerary → route → budget → booking
        </span>
      </div>
      <button class="primary" onclick="scrollToId('planner')">Start AI Planner →</button>
    </div>

  </div>
</section>

<section class="section">
  <div class="sectionHead">
    <div>
      <h2>Everything for Your Journey</h2>
      <p>One marketplace for the complete travel experience.</p>
    </div>
  </div>

  <div class="categories">

    <div class="cat" onclick="filterType('hotel')"><div class="catIcon">🏨</div><small>Hotel</small></div>
    <div class="cat" onclick="filterType('villa')"><div class="catIcon">🏡</div><small>Villa</small></div>
