  const name =
    document.getElementById("adminName").value.trim();

  if(!name){

    showToast("Enter product name");

    return;

  }

  const p = {

    id:makeId("P"),

    type:document.getElementById("adminType").value,

    category:
      document.getElementById("adminType")
        .selectedOptions[0].text,

    name:name,

    country:
      document.getElementById("adminCountry").value,

    city:
      document.getElementById("adminCity").value,

    price:
      Number(document.getElementById("adminPrice").value || 0),

    rating:
      Number(document.getElementById("adminRating").value || 4.5),

    image:
      document.getElementById("adminImage").value ||
      IMG.bali,

    description:
      "Demo product added by HobbiGo Admin."

  };

  products.unshift(p);

  saveProducts();

  renderProducts();

  renderAdmin();

  document.getElementById("adminName").value="";

  showToast("Product added to HobbiGo inventory ✓");

}

function deleteProduct(id){

  products = products.filter(p=>p.id!==id);

  saveProducts();

  renderProducts();

  renderAdmin();

  showToast("Product deleted");

}

function scrollToId(id){

  const el = document.getElementById(id);

  if(el){
    el.scrollIntoView({
      behavior:"smooth",
      block:"start"
    });
  }

}

function goHome(){

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}

function openModal(id){

  document.getElementById(id)
    .classList.add("show");

}

function closeModal(id){

  document.getElementById(id)
    .classList.remove("show");

}

function showToast(text){

  const t = document.getElementById("toast");

  t.textContent=text;

  t.classList.add("show");

  setTimeout(()=>{
    t.classList.remove("show");
  },2500);

}

window.addEventListener("click",function(e){

  if(e.target.classList.contains("modal")){

    e.target.classList.remove("show");

  }

});

init();

</script>

</body>
</html>
