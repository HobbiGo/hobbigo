function init(){

  products = JSON.parse(localStorage.getItem(PRODUCT_KEY) || "null");

  if(!products || !products.length){
    products = seedData();
    saveProducts();
  }

  cart = JSON.parse(localStorage.getItem(CART_KEY) || "[]");
  orders = JSON.parse(localStorage.getItem(ORDER_KEY) || "[]");

  document.getElementById("aiDate").value =
    new Date().toISOString().split("T")[0];

  document.getElementById("searchDate").value =
    new Date().toISOString().split("T")[0];

  renderProducts();
  updateCartBadge();

}

function saveProducts(){
  localStorage.setItem(PRODUCT_KEY,JSON.stringify(products));
}

function saveCart(){
  localStorage.setItem(CART_KEY,JSON.stringify(cart));
}

function saveOrders(){
  localStorage.setItem(ORDER_KEY,JSON.stringify(orders));
}

function renderProducts(){

  const box = document.getElementById("products");

  const q = (document.getElementById("searchDestination")?.value || "")
    .toLowerCase();

  const country = document.getElementById("searchCountry")?.value || "";

  let list = products.filter(p=>{

    const typeOk = activeType==="all" || p.type===activeType;

    const qOk = !q ||
      p.name.toLowerCase().includes(q) ||
      p.city.toLowerCase().includes(q) ||
      p.country.toLowerCase().includes(q);

    const countryOk = !country || p.country===country;

    return typeOk && qOk && countryOk;

  });

  if(!list.length){
    box.innerHTML =
      `<div class="empty" style="grid-column:1/-1">
        <h3>No demo inventory found</h3>
        <p>Try another destination or category.</p>
      </div>`;
    return;
  }

  box.innerHTML = list.map(p=>`

    <div class="card">

      <div class="cardImg">

        <img src="${esc(p.image)}"
             alt="${esc(p.name)}"
             onerror="this.src='${IMG.bali}'">

        <span class="typeBadge">${esc(p.category)}</span>

        <button class="heart"
          onclick="favorite('${p.id}')">♡</button>

      </div>

      <div class="cardBody">

        <h3>${esc(p.name)}</h3>

        <div class="location">
          📍 ${esc(p.city)}, ${esc(p.country)}
        </div>

        <div class="rating">
          ⭐ ${p.rating} · Highly rated
        </div>

        <div class="price">
          ${money(p.price)}
          <small>/ booking</small>
        </div>

        <div class="cardActions">

          <button class="secondary"
            onclick="showDetail('${p.id}')">
            Details
          </button>

          <button class="primary"
            onclick="openBooking('${p.id}')">
            Book
          </button>

        </div>

      </div>

    </div>

  `).join("");

}

function filterType(type){

  activeType = type || "all";

  const select = document.getElementById("typeFilter");

  if(select) select.value = activeType;

  renderProducts();

  scrollToId("productsSection");

}

