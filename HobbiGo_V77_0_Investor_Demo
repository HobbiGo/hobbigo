<title>HobbiGo V77.0</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f7fb;
  color:#172033;
}

button,input,select{
  font-family:inherit;
}

button{
  cursor:pointer;
  border:0;
}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:white;
  border-bottom:1px solid #e6eaf0;
  padding:14px 5%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.logo{
  font-size:28px;
  font-weight:900;
  color:#173b8f;
}

.logo span{
  color:#f3a51f;
}

.nav{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}

.nav button{
  background:#eef2f8;
  color:#24314d;
  padding:9px 13px;
  border-radius:9px;
  font-weight:bold;
}

.nav button:hover{
  background:#dfe8fb;
}

.cart-button{
  background:#173b8f!important;
  color:white!important;
}

.badge{
  background:#f3a51f;
  color:#111;
  border-radius:50%;
  padding:3px 7px;
  font-size:11px;
}

.hero{
  background:
  linear-gradient(135deg,rgba(13,42,102,.96),rgba(33,113,190,.91)),
  radial-gradient(circle at top right,#fff4,transparent 40%);
  color:white;
  padding:65px 5%;
}

.hero-inner{
  max-width:1200px;
  margin:auto;
}

.hero h1{
  font-size:44px;
  max-width:850px;
  margin:15px 0;
}

.hero p{
  max-width:760px;
  line-height:1.7;
  font-size:17px;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:30px 5%;
}

.section{
  display:none;
}

.section.active{
  display:block;
}

.panel{
  background:white;
  border-radius:18px;
  padding:24px;
  margin-bottom:22px;
  box-shadow:0 8px 30px rgba(25,45,80,.08);
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:18px;
}

.section-title h2{
  margin:0;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:15px;
}

.field label{
  display:block;
  font-size:12px;
  font-weight:bold;
  color:#657188;
  margin-bottom:7px;
}

.field input,
.field select{
  width:100%;
  padding:12px;
  border:1px solid #dce2ec;
  border-radius:10px;
  background:white;
}

.primary{
  background:#173b8f;
  color:white;
  padding:12px 18px;
  border-radius:10px;
  font-weight:bold;
}

.primary:hover{
  background:#0d2b6e;
}

.secondary{
  background:#eaf0ff;
  color:#173b8f;
  padding:11px 16px;
  border-radius:10px;
  font-weight:bold;
}

.warning{
  background:#fff3d9;
  color:#875900;
  padding:11px 15px;
  border-radius:10px;
}

.danger{
  background:#ffecec;
  color:#bd3030;
  padding:8px 11px;
  border-radius:8px;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:18px;
}

.tag{
  display:inline-block;
  padding:5px 9px;
  border-radius:20px;
  background:#edf3ff;
  color:#2553a2;
  font-size:11px;
  font-weight:bold;
  margin:2px;
}

.muted{
  color:#718096;
  font-size:13px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:17px;
}

.card{
  background:white;
  border:1px solid #e3e8f0;
  border-radius:15px;
  overflow:hidden;
}

.card-image{
  height:130px;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:48px;
  background:linear-gradient(135deg,#dce9ff,#f2f6fb);
}

.card-body{
  padding:16px;
}

.card h3{
  font-size:17px;
  margin:9px 0 7px;
}

.price{
  color:#173b8f;
  font-size:20px;
  font-weight:900;
  margin:9px 0;
}

.result-box{
  background:#f8fbff;
  border:1px solid #dce8fb;
  border-left:4px solid #f3a51f;
  border-radius:10px;
  padding:16px;
  margin-top:18px;
}

.success{
  background:#edf8ef;
  border:1px solid #cce8d0;
  color:#286332;
  padding:15px;
  border-radius:10px;
}

.route{
  display:grid;
  grid-template-columns:1fr 100px 1fr;
  align-items:center;
  text-align:center;
  background:#f7f9fd;
  padding:25px;
  border-radius:15px;
}

.route-line{
  height:3px;
  background:#9aafd4;
}

.itinerary{
  border-bottom:1px solid #e8ecf2;
  padding:14px 0;
  display:flex;
  gap:15px;
}

.time{
  color:#173b8f;
  font-weight:900;
  min-width:65px;
}

.total{
  font-size:28px;
  font-weight:900;
  color:#173b8f;
}

.empty{
  text-align:center;
  padding:30px;
  color:#718096;
}

footer{
  background:#111c32;
  color:#c8d2e3;
  padding:30px 5%;
  text-align:center;
  line-height:1.7;
}

.modal{
  position:fixed;
  inset:0;
  z-index:500;
  background:rgba(0,0,0,.65);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal.active{
  display:flex;
}

.modal-box{
  width:100%;
  max-width:600px;
  max-height:90vh;
  overflow:auto;
  background:white;
  border-radius:18px;
  padding:25px;
}

@media(max-width:750px){

  header{
    align-items:flex-start;
  }

  .nav{
    display:none;
  }

  .hero h1{
    font-size:32px;
  }

  .route{
    grid-template-columns:1fr;
    gap:15px;
  }

  .route-line{
    width:3px;
    height:35px;
    margin:auto;
  }
}
</style>
</head>

