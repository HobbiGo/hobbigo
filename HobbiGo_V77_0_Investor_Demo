/* =========================================================
   MARKETPLACE
========================================================= */


function renderProducts(){

const category =
document.getElementById(
"categoryFilter"
).value;

const search =
(
document.getElementById(
"searchProduct"
).value
||""
).toLowerCase();


const filtered =
products.filter(function(product){

const categoryOK =
category==="All"
||
product.category===category;

const searchOK =
(
product.name+
" "+
product.location+
" "+
product.category
)
.toLowerCase()
.includes(search);

return categoryOK && searchOK;

});


document.getElementById(
"productCount"
).textContent =
filtered.length+
" Products";


document.getElementById(
"productGrid"
).innerHTML =
filtered.map(function(product){

return `

<div class="card">

<div class="card-image">

${product.icon}

</div>

<div class="card-body">

<span class="tag">
${product.category}
</span>

<span class="tag">
★ ${product.rating}
</span>

<h3>
${product.name}
</h3>

<div class="muted">
📍 ${product.location}
</div>

<div class="price">
${rupiah(product.price)}
</div>

<div class="muted">
per ${product.unit}
</div>

<p class="muted">
${product.description}
</p>

<div class="actions">

<button
class="primary"
onclick="addToCart(${product.id})">

Add to Cart

</button>

<button
class="secondary"
onclick="showProduct(${product.id})">

Detail

</button>

</div>

</div>

</div>

`;

}).join("");

}


/* =========================================================
   ADD TO CART
========================================================= */


function addToCart(id){

const product =
products.find(
function(item){
return item.id===id;
}
);


if(!product){

return;

}


cart.push({

...product,

cartId:
Date.now()+
Math.random()

});


updateCartBadge();


alert(
product.name+
" berhasil ditambahkan ke Cart."
);

}


/* =========================================================
   CART BADGE
========================================================= */


function updateCartBadge(){

document.getElementById(
"cartCount"
).textContent =
cart.length;

}


/* =========================================================
   CART
========================================================= */


function renderCart(){

const container =
document.getElementById(
"cartContent"
);


if(cart.length===0){

container.innerHTML = `

<div class="empty">

🛒 Cart masih kosong.

<br><br>

Silakan pilih produk dari Marketplace.

</div>

`;

document.getElementById(
"cartTotal"
).textContent =
"Rp 0";

return;

}


let total=0;

let html="";


cart.forEach(function(item){

total += item.price;


html += `

<div class="itinerary">

<div style="font-size:35px">

${item.icon}

</div>

<div style="flex:1">

<b>
${item.name}
</b>

<br>

<span class="muted">
${item.category}
·
${item.location}
</span>

<br><br>

<b>
${rupiah(item.price)}
</b>

</div>

<button
class="danger"
onclick="removeFromCart(${item.cartId})">

Remove

</button>

</div>

`;

});


container.innerHTML=html;


document.getElementById(
"cartTotal"
).textContent =
rupiah(total);

}


/* =========================================================
   REMOVE CART
========================================================= */


function removeFromCart(cartId){

cart =
cart.filter(function(item){

return item.cartId!==cartId;

});


updateCartBadge();

renderCart();

renderBooking();

}


/* =========================================================
   CLEAR CART
========================================================= */


function clearCart(){

cart=[];

updateCartBadge();

renderCart();

renderBooking();

}


/* =========================================================
   TOTAL
========================================================= */


function getCartTotal(){

return cart.reduce(
function(total,item){

return total+
item.price;

},
0
);

}


/* =========================================================
   BOOKING
========================================================= */


function renderBooking(){

const container =
document.getElementById(
"bookingItems"
);


if(cart.length===0){

container.innerHTML = `

<div class="empty">

Belum ada item di Cart.

<br><br>

Silakan kembali ke Marketplace.

</div>

`;

document.getElementById(
"bookingTotal"
).textContent =
"Rp 0";

return;

}


let html="";


cart.forEach(function(item){

html += `

<div class="itinerary">

<div style="font-size:30px">
${item.icon}
</div>

<div>

<b>
${item.name}
</b>

<br>

<span class="muted">
${item.category}
·
${item.location}
</span>

<br>

${rupiah(item.price)}

</div>

</div>

`;

});


container.innerHTML=html;


document.getElementById(
"bookingTotal"
).textContent =
rupiah(getCartTotal());

}


/* =========================================================
   CONFIRM BOOKING
========================================================= */


function confirmBooking(){

if(cart.length===0){

alert(
"Cart masih kosong. Silakan pilih produk terlebih dahulu."
);

return;

}


const name =
document.getElementById(
"customerName"
).value.trim();


const email =
document.getElementById(
"customerEmail"
).value.trim();


if(!name){

alert(
"Masukkan nama traveler terlebih dahulu."
);

return;

}


if(!email){

alert(
"Masukkan email traveler terlebih dahulu."
);

return;

}


const bookingID =
"HBG-"+
Date.now()
.toString()
.slice(-8);


document.getElementById(
"bookingResult"
).innerHTML = `

<div class="success">

<h3>
✅ Booking Confirmed
</h3>

<b>
Booking ID:
${bookingID}
</b>

<br><br>

Traveler:
${name}

<br>

Email:
${email}

<br>

Payment:
${
document.getElementById(
"paymentMethod"
).value
}

<br>

Total:
<b>
${rupiah(getCartTotal())}
</b>

<br><br>

⚠️ Ini adalah
<b>Payment Demo</b>.
Tidak ada transaksi uang nyata.

</div>

`;

}


